              <xs:enumeration value="01 eerste verdieping" />
              <xs:enumeration value="02 tweede verdieping" />
              <xs:enumeration value="03 derde verdieping" />
              <xs:enumeration value="04 vierde verdieping" />
              <xs:enumeration value="05 vijfde verdieping" />
              <xs:enumeration value="06 zesde verdieping" />
              <xs:enumeration value="07 zevende verdieping" />
              <xs:enumeration value="08 achtste verdieping" />
              <xs:enumeration value="09 negende verdieping" />
              <xs:enumeration value="10 tiende verdieping" />
              <xs:enumeration value="11 elfde verdieping" />
              <xs:enumeration value="12 twaalfde verdieping" />
              <xs:enumeration value="13 dertiende verdieping" />
              <xs:enumeration value="14 veertiende verdieping" />
              <xs:enumeration value="15 vijftiende verdieping" />
              <xs:enumeration value="16 zestiende verdieping" />
              <xs:enumeration value="17 zeventiende verdieping" />
              <xs:enumeration value="18 achttiende verdieping" />
              <xs:enumeration value="19 negentiende verdieping" />
              <xs:enumeration value="20 twintigste verdieping" />
              <xs:enumeration value="21 eenentwintigste verdieping" />
              <xs:enumeration value="22 tweeentwintigste verdieping" />
              <xs:enumeration value="23 drieentwintigste verdieping" />
              <xs:enumeration value="24 vierentwintigste verdieping" />
              <xs:enumeration value="25 vijfentwintigste verdieping" />
              <xs:enumeration value="26 zesentwintigste verdieping" />
              <xs:enumeration value="27 zevenentwintigste verdieping" />
              <xs:enumeration value="28 achtentwintigste verdieping" />
              <xs:enumeration value="29 negentwintigste verdieping" />
              <xs:enumeration value="30 dertigste verdieping" />
              <xs:enumeration value="31 eenendertigste verdieping" />
              <xs:enumeration value="32 tweeendertigste verdieping" />
              <xs:enumeration value="33 drieendertigste verdieping" />
              <xs:enumeration value="34 vierendertigste verdieping" />
              <xs:enumeration value="35 vijfendertigste verdieping" />
              <xs:enumeration value="36 zesendertigste verdieping" />
              <xs:enumeration value="37 zevenendertigste verdieping" />
              <xs:enumeration value="38 achtendertigste verdieping" />
              <xs:enumeration value="39 negendertigste verdieping" />
              <xs:enumeration value="40 veertigste verdieping" />
              <xs:enumeration value="01 dak" />
              <xs:enumeration value="02 dak" />
              <xs:enumeration value="03 dak" />
              <xs:enumeration value="04 dak" />
              <xs:enumeration value="05 dak" />
              <xs:enumeration value="06 dak" />
              <xs:enumeration value="07 dak" />
              <xs:enumeration value="08 dak" />
              <xs:enumeration value="09 dak" />
              <xs:enumeration value="10 dak" />
              <xs:enumeration value="11 dak" />
              <xs:enumeration value="12 dak" />
              <xs:enumeration value="13 dak" />
              <xs:enumeration value="14 dak" />
              <xs:enumeration value="15 dak" />
              <xs:enumeration value="16 dak" />
              <xs:enumeration value="17 dak" />
              <xs:enumeration value="18 dak" />
              <xs:enumeration value="19 dak" />
              <xs:enumeration value="20 dak" />
              <xs:enumeration value="21 dak" />
              <xs:enumeration value="22 dak" />
              <xs:enumeration value="23 dak" />
              <xs:enumeration value="24 dak" />
              <xs:enumeration value="25 dak" />
              <xs:enumeration value="26 dak" />
              <xs:enumeration value="27 dak" />
              <xs:enumeration value="28 dak" />
              <xs:enumeration value="29 dak" />
              <xs:enumeration value="30 dak" />
              <xs:enumeration value="31 dak" />
              <xs:enumeration value="32 dak" />
              <xs:enumeration value="33 dak" />
              <xs:enumeration value="34 dak" />
              <xs:enumeration value="35 dak" />
              <xs:enumeration value="36 dak" />
              <xs:enumeration value="37 dak" />
              <xs:enumeration value="38 dak" />
              <xs:enumeration value="39 dak" />
              <xs:enumeration value="40 dak" />
              <xs:enumeration value="41 dak" />
            </xs:restriction>
          </ids:value>
        </ids:attribute>
        <ids:attribute cardinality="required" instructions="Bepalingsmethode voorbeeld: Bruto-Inhoud">
          <ids:name>
            <ids:simpleValue>Description</ids:simpleValue>
          </ids:name>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:enumeration value="Terreinvolume" />
              <xs:enumeration value="Onbebouwd terreinvolume" />
              <xs:enumeration value="Overbouwd terreinvolume" />
              <xs:enumeration value="Onderbouwd terreinvolume" />
              <xs:enumeration value="Bebouwd terreinvolume" />
              <xs:enumeration value="Netto inhoud" />
              <xs:enumeration value="Bruto inhoud" />
              <xs:enumeration value="Tarra inhoud" />
              <xs:enumeration value="Gebruiksinhoud" />
              <xs:enumeration value="Verhuurbare inhoud" />
              <xs:enumeration value="Nuttige inhoud" />
              <xs:enumeration value="Funcitoneel nuttige inhoud" />
              <xs:enumeration value="Programma van Eisen inhoud" />
            </xs:restriction>
          </ids:value>
        </ids:attribute>
        <ids:attribute cardinality="optional" instructions="Beschrijving van het soort IfcBuildingStorey&#xA;Voorbeeld: Entreeverdieping">
          <ids:name>
            <ids:simpleValue>ObjectType</ids:simpleValue>
          </ids:name>
        </ids:attribute>
        <ids:attribute cardinality="required">
          <ids:name>
            <ids:simpleValue>ObjectPlacement</ids:simpleValue>
          </ids:name>
        </ids:attribute>
        <ids:attribute cardinality="required">
          <ids:name>
            <ids:simpleValue>Representation</ids:simpleValue>
          </ids:name>
        </ids:attribute>
        <ids:attribute cardinality="optional">
          <ids:name>
            <ids:simpleValue>LongName</ids:simpleValue>
          </ids:name>
        </ids:attribute>
        <ids:property dataType="IFCBOOLEAN" uri="https://identifier.buildingsmart.org/uri/buildingsmart/ifc/4.3/prop/EntranceLevel" cardinality="required">
          <ids:propertySet>
            <ids:simpleValue>Pset_BuildingStoreyCommon</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>EntranceLevel</ids:simpleValue>
          </ids:baseName>
        </ids:property>
      </ids:requirements>
    </ids:specification>
    <ids:specification ifcVersion="IFC4 IFC4X3_ADD2" name="9.08 Gebruiksfunctie met IfcZone, IfcSpatialZone of IfcSpace" description="Aanbeveling 05:&#xA;*Let op! Het gebruik van IfcZone is alleen mogelijk als er geen niet-dragende-separatiewanden onderdeel zijn van het gebied of als onderdeel zijnde niet-dragende separatiewanden gemodelleerd zijn als IfcSpace of als (onderdeel van) IfcSpatialZone (Bepalingsmethode Tarra Inhoud Objecttype Tarra Ruimte)&#xA;&#xA;Aanbeveling 06&#xA;*Let op! Voor IfcSpace geldt aanbeveling 4 (of 5)? check? ook wanneer IfcSpace een compositie is." instructions="Requirement 12:&#xA;Een BIM-Model voor de activiteit “Nieuw gebouw bouwen” dient minimaal 1 IFCClass IfcZone, IfcSpace of IfcSpatialZone te hebben van het objecttype gebruiksfunctie. De attributen Name, Description en Objecttype zijn verplicht. Verwijzing naar object met geometrie of eigen geometrie is verplicht.&#xA;&#xA;Requirement 13:&#xA;Een BIM-Model dient bij een objecttype gebruiksfunctie en de Name anders dan Woonfunctie de property Occupancytype in te vullen met de beschikbare SBI-code.">
      <ids:applicability minOccurs="1" maxOccurs="unbounded">
        <ids:entity>
          <ids:name>
            <xs:restriction base="xs:string">
              <xs:enumeration value="IFCZONE" />
              <xs:enumeration value="IFCSPATIALZONE" />
              <xs:enumeration value="IFCSPACE" />
            </xs:restriction>
          </ids:name>
        </ids:entity>
        <ids:attribute>
          <ids:name>
            <ids:simpleValue>ObjectType</ids:simpleValue>
          </ids:name>
          <ids:value>
            <ids:simpleValue>Gebruiksfunctie</ids:simpleValue>
          </ids:value>
        </ids:attribute>
      </ids:applicability>
      <ids:requirements>
        <ids:attribute cardinality="required" instructions="Gebruiksfunctie volgens enumeratie BBL&#xA;Woonfunctie, Bijeenkomstfunctie, Celfunctie, Gezondheidszorgfunctie, Industriefunctie, Kantoorfunctie, Logiesfunctie, Onderwijsfunctie, Sportfunctie, Winkelfunctie, Overige gebruiksfunctie, Bouwwerk geen gebouw zijnde&#xA;Subgebruikfuncties">
          <ids:name>
            <ids:simpleValue>Name</ids:simpleValue>
          </ids:name>
        </ids:attribute>
        <ids:attribute cardinality="required" instructions="Bepalingsmethode Bruto-inhoud, Gebruiks-inhoud">
          <ids:name>
            <ids:simpleValue>Description</ids:simpleValue>
          </ids:name>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:enumeration value="Terreinvolume" />
              <xs:enumeration value="Onbebouwd terreinvolume" />
              <xs:enumeration value="Overbouwd terreinvolume" />
              <xs:enumeration value="Onderbouwd terreinvolume" />
              <xs:enumeration value="Bebouwd terreinvolume" />
              <xs:enumeration value="Netto inhoud" />
              <xs:enumeration value="Bruto inhoud" />
              <xs:enumeration value="Tarra inhoud" />
              <xs:enumeration value="Gebruiksinhoud" />
              <xs:enumeration value="Verhuurbare inhoud" />
              <xs:enumeration value="Nuttige inhoud" />
              <xs:enumeration value="Funcitoneel nuttige inhoud" />
              <xs:enumeration value="Programma van Eisen inhoud" />
            </xs:restriction>
          </ids:value>
        </ids:attribute>
        <ids:attribute cardinality="required">
          <ids:name>
            <ids:simpleValue>ObjectType</ids:simpleValue>
          </ids:name>
          <ids:value>
            <ids:simpleValue>Gebruiksfunctie</ids:simpleValue>
          </ids:value>
        </ids:attribute>
        <ids:attribute cardinality="optional" instructions="Hier de BBL subgebruiksfuncties onder woonfunctie indien van toepassing.&#xA;Woonfunctie voor kamergewijze verhuur&#xA;Woonfunctie voor studenten&#xA;Woonfunctie voor particulier eigendom&#xA;Woonfunctie voor zorg&#xA;">
          <ids:name>
            <ids:simpleValue>LongName</ids:simpleValue>
          </ids:name>
        </ids:attribute>
        <ids:property dataType="IFCLABEL" uri="https://identifier.buildingsmart.org/uri/buildingsmart/ifc/4.3/prop/OccupancyType" cardinality="optional" instructions="Requirement 13&#xA;Een BIM-Model dient bij een ObjectType Gebruiksfunctie en de Name anders dan Woonfunctie de property Occupancytype in te vullen met de beschikbare SBI-code.&#xA;https://www.kvk.nl/over-het-handelsregister/overzicht-standaard-bedrijfsindeling-sbi-codes-voor-activiteiten/">
          <ids:propertySet>
            <ids:simpleValue>Pset_SpaceOccupancyRequirements</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>Occupancy Type [OccupancyType]</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property dataType="IFCINTEGER" uri="https://identifier.buildingsmart.org/uri/buildingsmart/ifc/4.3/prop/OccupancyNumber" cardinality="optional">
          <ids:propertySet>
            <ids:simpleValue>Pset_SpaceOccupancyRequirements</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>Occupancy Number [OccupancyNumber]</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property dataType="IFCINTEGER" uri="https://identifier.buildingsmart.org/uri/buildingsmart/ifc/4.3/prop/OccupancyNumberPeak" cardinality="optional">
          <ids:propertySet>
            <ids:simpleValue>Pset_SpaceOccupancyRequirements</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>Occupancy Number Peak [OccupancyNumberPeak]</ids:simpleValue>
          </ids:baseName>
        </ids:property>
      </ids:requirements>
    </ids:specification>
    <ids:specification ifcVersion="IFC4 IFC4X3_ADD2" name="9.08a Gebruiksfunctie met IfcZone" instructions="Requirement 12:&#xA;Een BIM-Model voor de activiteit “Nieuw gebouw bouwen” dient minimaal 1 IFCClass IfcZone, IfcSpace of IfcSpatialZone te hebben van het objecttype gebruiksfunctie. De attributen Name, Description en Objecttype zijn verplicht. Verwijzing naar object met geometrie of eigen geometrie is verplicht.">
      <ids:applicability minOccurs="0" maxOccurs="unbounded">
        <ids:entity>
          <ids:name>
            <ids:simpleValue>IFCZONE</ids:simpleValue>
          </ids:name>
        </ids:entity>
        <ids:attribute>
          <ids:name>
            <ids:simpleValue>ObjectType</ids:simpleValue>
          </ids:name>
          <ids:value>
            <ids:simpleValue>Gebruiksfunctie</ids:simpleValue>
          </ids:value>
        </ids:attribute>
      </ids:applicability>
      <ids:requirements>
        <ids:partOf relation="IFCRELASSIGNSTOGROUP" cardinality="required" instructions="Relatie naar (ifcSpace, IfcSpatialZone, of IfcZone) die lid is van de ifcZone groep.">
          <ids:entity>
            <ids:name>
              <xs:restriction base="xs:string">
                <xs:enumeration value="IFCSPACE" />
                <xs:enumeration value="IFCSPATIALZONE" />
                <xs:enumeration value="IFCZONE" />
              </xs:restriction>
            </ids:name>
          </ids:entity>
        </ids:partOf>
      </ids:requirements>
    </ids:specification>
    <ids:specification ifcVersion="IFC4 IFC4X3_ADD2" name="9.08b Gebruiksfunctie met IfcSpatialZone" instructions="Requirement 12:&#xA;Een BIM-Model voor de activiteit “Nieuw gebouw bouwen” dient minimaal 1 IFCClass IfcZone, IfcSpace of IfcSpatialZone te hebben van het objecttype gebruiksfunctie. De attributen Name, Description en Objecttype zijn verplicht. Verwijzing naar object met geometrie of eigen geometrie is verplicht.">
      <ids:applicability minOccurs="0" maxOccurs="unbounded">
        <ids:entity>
          <ids:name>
            <ids:simpleValue>IFCSPATIALZONE</ids:simpleValue>
          </ids:name>
        </ids:entity>
        <ids:attribute>
          <ids:name>
            <ids:simpleValue>ObjectType</ids:simpleValue>
          </ids:name>
          <ids:value>
            <ids:simpleValue>Gebruiksfunctie</ids:simpleValue>
          </ids:value>
        </ids:attribute>
      </ids:applicability>
      <ids:requirements>
        <ids:partOf relation="IFCRELCONTAINEDINSPATIALSTRUCTURE" cardinality="required" instructions="controle vraag relref etc.&#xA;">
          <ids:entity>
            <ids:name>
              <ids:simpleValue>IFCRELREFERENCEDINSPATIALSTRUCTURE</ids:simpleValue>
            </ids:name>
          </ids:entity>
        </ids:partOf>
        <ids:attribute cardinality="required" instructions="We willen IfcRelRef eerst hebben ipv IfcRelCon">
          <ids:name>
            <ids:simpleValue>ObjectPlacement</ids:simpleValue>
          </ids:name>
        </ids:attribute>
        <ids:attribute cardinality="required">
          <ids:name>
            <ids:simpleValue>Representation</ids:simpleValue>
          </ids:name>
        </ids:attribute>
      </ids:requirements>
    </ids:specification>
    <ids:specification ifcVersion="IFC4 IFC4X3_ADD2" name="9.08c Gebruiksfunctie met IfcSpace" description="Aanbeveling 06:&#xA;*Let op! Voor IfcSpace geldt aanbeveling 4 ook wanneer IfcSpace een compositie is." instructions="Requirement 12:&#xA;Een BIM-Model voor de activiteit “Nieuw gebouw bouwen” dient minimaal 1 IFCClass IfcZone, IfcSpace of IfcSpatialZone te hebben van het objecttype gebruiksfunctie. De attributen Name, Description en Objecttype zijn verplicht. Verwijzing naar object met geometrie of eigen geometrie is verplicht.">
      <ids:applicability minOccurs="0" maxOccurs="unbounded">
        <ids:entity>
          <ids:name>
            <ids:simpleValue>IFCSPACE</ids:simpleValue>
          </ids:name>
        </ids:entity>
        <ids:attribute>
          <ids:name>
            <ids:simpleValue>ObjectType</ids:simpleValue>
          </ids:name>
          <ids:value>
            <ids:simpleValue>Gebruiksfunctie</ids:simpleValue>
          </ids:value>
        </ids:attribute>
      </ids:applicability>
      <ids:requirements>
        <ids:partOf relation="IFCRELAGGREGATES" cardinality="required" instructions="We willen IfcRelRef eerst hebben ipv IfcRelCon&#xA;&#xA;">
          <ids:entity>
            <ids:name>
              <xs:restriction base="xs:string">
                <xs:enumeration value="IFCSPACE" />
                <xs:enumeration value="IFCSPATIALZONE" />
                <xs:enumeration value="IFCZONE" />
              </xs:restriction>
            </ids:name>
          </ids:entity>
        </ids:partOf>
        <ids:attribute cardinality="required">
          <ids:name>
            <ids:simpleValue>ObjectPlacement</ids:simpleValue>
          </ids:name>
        </ids:attribute>
        <ids:attribute cardinality="required">
          <ids:name>
            <ids:simpleValue>Representation</ids:simpleValue>
          </ids:name>
        </ids:attribute>
      </ids:requirements>
    </ids:specification>
    <ids:specification ifcVersion="IFC4 IFC4X3_ADD2" name="9.09 Nevengebruiksfunctie met IfcZone, IfcSpace of IfcSpatialZone" instructions="Requirement 14:&#xA;Wanneer een BIM-Model voor de activiteit “Nieuw gebouw bouwen” een nevengebruiksfunctie bevat dient minimaal 1 IFCClass IfcZone, IfcSpace of IfcSpatialZone te hebben van het objecttype nevengebruiksfunctie. De attributen Name, Description en Objecttype zijn verplicht. Verwijzing naar object met geometrie of eigen geometrie is verplicht.">
      <ids:applicability minOccurs="1" maxOccurs="unbounded">
        <ids:entity>
          <ids:name>
            <xs:restriction base="xs:string">
              <xs:enumeration value="IFCZONE" />
              <xs:enumeration value="IFCSPATIALZONE" />
              <xs:enumeration value="IFCSPACE" />
            </xs:restriction>
          </ids:name>
        </ids:entity>
        <ids:attribute>
          <ids:name>
            <ids:simpleValue>ObjectType</ids:simpleValue>
          </ids:name>
          <ids:value>
            <ids:simpleValue>Nevengebruiksfunctie</ids:simpleValue>
          </ids:value>
        </ids:attribute>
      </ids:applicability>
      <ids:requirements>
        <ids:attribute cardinality="required" instructions="Gebruiksfunctie volgens enumeratie BBL&#xA;Voorbeeld: Kantoorfunctie">
          <ids:name>
            <ids:simpleValue>Name</ids:simpleValue>
          </ids:name>
        </ids:attribute>
        <ids:attribute cardinality="required" instructions="Bepalingsmethode&#xA;Voorbeeld: Gebruiks-Inhoud">
          <ids:name>
            <ids:simpleValue>Description</ids:simpleValue>
          </ids:name>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:enumeration value="Terreinvolume" />
              <xs:enumeration value="Onbebouwd terreinvolume" />
              <xs:enumeration value="Overbouwd terreinvolume" />
              <xs:enumeration value="Onderbouwd terreinvolume" />
              <xs:enumeration value="Bebouwd terreinvolume" />
              <xs:enumeration value="Netto inhoud" />
              <xs:enumeration value="Bruto inhoud" />
              <xs:enumeration value="Tarra inhoud" />
              <xs:enumeration value="Gebruiksinhoud" />
              <xs:enumeration value="Verhuurbare inhoud" />
              <xs:enumeration value="Nuttige inhoud" />
              <xs:enumeration value="Funcitoneel nuttige inhoud" />
              <xs:enumeration value="Programma van Eisen inhoud" />
            </xs:restriction>
          </ids:value>
        </ids:attribute>
        <ids:attribute cardinality="required" instructions="Beschrijving van het soort ruimte (Gebruiksfunctie is de enige die hieraan gekoppeld mag zijn)&#xA;Voorbeeld: Nevengebruiksfunctie">
          <ids:name>
            <ids:simpleValue>ObjectType</ids:simpleValue>
          </ids:name>
        </ids:attribute>
        <ids:attribute cardinality="optional">
          <ids:name>
            <ids:simpleValue>LongName</ids:simpleValue>
          </ids:name>
        </ids:attribute>
        <ids:property dataType="IFCLABEL" uri="https://identifier.buildingsmart.org/uri/buildingsmart/ifc/4.3/prop/OccupancyType" cardinality="optional" instructions="Gebruik (SBI-code of woning) uit Pset_SpaceOccupancy-Requirements&#xA;Voorbeeld: 69.20.3 Boekhoud-kantoren">
          <ids:propertySet>
            <ids:simpleValue>Pset_SpaceOccupancyRequirements</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>Occupancy Type [OccupancyType]</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property dataType="IFCINTEGER" uri="https://identifier.buildingsmart.org/uri/buildingsmart/ifc/4.3/prop/OccupancyNumberPeak" cardinality="optional" instructions="Bedoelde hoeveelheid voor gebruiksfunctie&#xA;Voorbeeld: 1">
          <ids:propertySet>
            <ids:simpleValue>Pset_SpaceOccupancyRequirements</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>Occupancy Number Peak [OccupancyNumberPeak]</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property dataType="IFCINTEGER" uri="https://identifier.buildingsmart.org/uri/buildingsmart/ifc/4.3/prop/OccupancyNumber" cardinality="optional" instructions="Maximale hoeveelheid voor gebruiksfunctie&#xA;Voorbeeld: 3">
          <ids:propertySet>
            <ids:simpleValue>Pset_SpaceOccupancyRequirements</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>Occupancy Number [OccupancyNumber]</ids:simpleValue>
          </ids:baseName>
        </ids:property>
      </ids:requirements>
    </ids:specification>
    <ids:specification ifcVersion="IFC4 IFC4X3_ADD2" name="9.09a Nevengebruiksfunctie met IfcZone" instructions="Requirement 14:&#xA;Wanneer een BIM-Model voor de activiteit “Nieuw gebouw bouwen” een nevengebruiksfunctie bevat dient minimaal 1 IFCClass IfcZone, IfcSpace of IfcSpatialZone te hebben van het objecttype nevengebruiksfunctie. De attributen Name, Description en Objecttype zijn verplicht. Verwijzing naar object met geometrie of eigen geometrie is verplicht.">
