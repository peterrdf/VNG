    <ids:specification ifcVersion="IFC4 IFC4X3_ADD2" name="9.14 Buitengebied met IfcZone, IfcSpatialZone, IfcSpace of IfcExternalSpatialElement" description="Aanbeveling 09:&#xA;Wanneer een BIM-Model voor de activiteit “Nieuw gebouw bouwen” een buitenruimte&#xA;bevat die onderbouwde of overbouwde delen bevat kan dit met een IFCClass&#xA;IfcExternalSpatialElement, IfcZone, IfcSpace of IfcSpatialZone van het objecttype&#xA;overbouwd of onderbouwd terrein aangegeven te worden die met ifcrelaggregates of&#xA;ifcRelAssignsToGroup verwijst naar het onbebouwd terrein." instructions="Requirement 19:&#xA;Wanneer een BIM-Model voor de activiteit “Nieuw gebouw bouwen” een buitenruimte&#xA;bevat dient minimaal 1 IfcClass IfcExternalSpatialElement, IfcZone, IfcSpace of&#xA;IfcSpatialZone te hebben van het objecttype onbebouwd terrein. De attributen Description&#xA;en Objecttype zijn verplicht. Verwijzing naar object met geometrie of eigen geometrie is&#xA;verplicht.">
      <ids:applicability minOccurs="1" maxOccurs="unbounded">
        <ids:entity>
          <ids:name>
            <xs:restriction base="xs:string">
              <xs:enumeration value="IFCEXTERNALSPATIALELEMENT" />
              <xs:enumeration value="IFCZONE" />
              <xs:enumeration value="IFCSPATIALZONE" />
              <xs:enumeration value="IFCSPACE" />
            </xs:restriction>
          </ids:name>
        </ids:entity>
      </ids:applicability>
      <ids:requirements>
        <ids:attribute cardinality="optional" instructions="Naam van het terrein&#xA;Voorbeeld: Overstek voorkant">
          <ids:name>
            <ids:simpleValue>Name</ids:simpleValue>
          </ids:name>
        </ids:attribute>
        <ids:attribute cardinality="required" instructions="Bepalingsmethode&#xA;Voorbeeld: TerreinVolume">
          <ids:name>
            <ids:simpleValue>Description</ids:simpleValue>
          </ids:name>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:enumeration value="Terreinvolume" />
              <xs:enumeration value="Onbebouwd terreinvolume" />
              <xs:enumeration value="Overbouwd terreinvolume" />
              <xs:enumeration value="Onderbouwd terreinvolume" />
              <xs:enumeration value="Bebouwd terreinvolume" />
              <xs:enumeration value="Netto inhoud" />
              <xs:enumeration value="Bruto inhoud" />
              <xs:enumeration value="Tarra inhoud" />
              <xs:enumeration value="Gebruiksinhoud" />
              <xs:enumeration value="Verhuurbare inhoud" />
              <xs:enumeration value="Nuttige inhoud" />
              <xs:enumeration value="Funcitoneel nuttige inhoud" />
              <xs:enumeration value="Programma van Eisen inhoud" />
            </xs:restriction>
          </ids:value>
        </ids:attribute>
        <ids:attribute cardinality="required" instructions="Beschrijving van het soort Terrein&#xA;(Onbebouwd, Overbouwd, Onderbouwd, Overbouwd en Onderbouwd, Bebouwd)">
          <ids:name>
            <ids:simpleValue>ObjectType</ids:simpleValue>
          </ids:name>
        </ids:attribute>
        <ids:attribute cardinality="optional">
          <ids:name>
            <ids:simpleValue>LongName</ids:simpleValue>
          </ids:name>
        </ids:attribute>
      </ids:requirements>
    </ids:specification>
    <ids:specification ifcVersion="IFC4 IFC4X3_ADD2" name="9.14a [kan niet] Buitengebied met IfcZone" description="Aanbeveling 09:&#xA;Wanneer een BIM-Model voor de activiteit “Nieuw gebouw bouwen” een buitenruimte&#xA;bevat die onderbouwde of overbouwde delen bevat kan dit met een IFCClass&#xA;IfcExternalSpatialElement, IfcZone, IfcSpace of IfcSpatialZone van het objecttype&#xA;overbouwd of onderbouwd terrein aangegeven te worden die met ifcrelaggregates of&#xA;ifcRelAssignsToGroup verwijst naar het onbebouwd terrein." instructions="Requirement 19:&#xA;Wanneer een BIM-Model voor de activiteit “Nieuw gebouw bouwen” een buitenruimte&#xA;bevat dient minimaal 1 IFCClass IfcExternalSpatialElement, IfcZone, IfcSpace of&#xA;IfcSpatialZone te hebben van het objecttype onbebouwd terrein. De attributen Description&#xA;en Objecttype zijn verplicht. Verwijzing naar object met geometrie of eigen geometrie is&#xA;verplicht.">
