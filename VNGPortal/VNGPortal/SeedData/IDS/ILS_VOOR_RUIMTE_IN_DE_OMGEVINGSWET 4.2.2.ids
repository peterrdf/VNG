<ids:ids xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://standards.buildingsmart.org/IDS http://standards.buildingsmart.org/IDS/1.0/ids.xsd" xmlns:ids="http://standards.buildingsmart.org/IDS">
  <!--edited with usBIM.IDSeditor 2.2.29.0 (http://www.accasoftware.com)-->
  <ids:info>
    <ids:title>ILS voor ruimten in de omgevingswet</ids:title>
    <ids:copyright>creative commons Gemeente Rotterdam, VORM, Root, VDCbase, Arons en Gelauff, BIM basis ILS, BuildingSMART NL, digiGO</ids:copyright>
    <ids:version>4.2.2</ids:version>
    <ids:description>IDS behorende bij: ILS VOOR RUIMTE IN DE OMGEVINGSWET
Van: Abe Reurings &amp; Rolf Jonker
ILS geschreven Q3-2024 met met input van: Wouter Streefkerk, Paul Strokap, Lex Ransijn, Menno Mekes, Juun Steen
IDS geconfigureerd Q4-2024 door Lex Ransijn, Abe Reurings en Rolf Jonker</ids:description>
    <ids:author>lex@vdcbase.com</ids:author>
    <ids:date>2024-11-29</ids:date>
    <ids:purpose>Indieningsvereisten van ruimte-modellering t.b.v. vergunningsaanvraag Omgevings Plan Activiteit (Omgevingsplan) en Technische Activiteit (BLL) voor bouwwerken zijnde Gebouw</ids:purpose>
    <ids:milestone>OmgevingsPlanActiviteit en Technische Activiteit</ids:milestone>
  </ids:info>
  <ids:specifications>
    <ids:specification ifcVersion="IFC4 IFC4X3_ADD2" name="9.01a Georefentie met IfcProjectedCRS" description="Aanbeveling 01: Deze CRS-eis geldt alleen voor Nederlandse projecten waarbij de omvang van het project i.c.m. de kromming van de aarde geen probleem oplevert. Als dit niet geldt dan is het ook mogelijk om eventueel IfcGeographicCRS en/of andere EPSG te gebruiken." instructions="Requirement 01: &#xA;Een BIM-Model moet de IFCClass IFCMAPCONVERSION bevatten met de attributen SourceCRS, TargetCRS, Easting, Northing, OrthogonalHeight, XAxisAbscissa, XAxisOrdinate en Scale ingevuld.&#xA;&#xA;Requirement 2: Het attribuut TargetCRS voor Nederlandse indiening heeft als verplichte waarde een IfcProjectedCRS met attribuut VerticalDatum EPSG:7415 (RD+NAP)of EPSG:28992 (RD) én EPSG:5709 (NAP)">
      <ids:applicability minOccurs="1" maxOccurs="unbounded">
        <ids:entity>
          <ids:name>
            <ids:simpleValue>IFCPROJECTEDCRS</ids:simpleValue>
          </ids:name>
        </ids:entity>
        <ids:attribute>
          <ids:name>
            <ids:simpleValue>Name</ids:simpleValue>
          </ids:name>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:enumeration value="EPSG:7415" />
              <xs:enumeration value="EPSG:28992" />
            </xs:restriction>
          </ids:value>
        </ids:attribute>
      </ids:applicability>
      <ids:requirements>
        <ids:attribute cardinality="required" instructions="Doel coördinatenstelsel waarin het BIM-model geplaatst wordt. EPSG 7415&#xA;Het attribuut TargetCRS voor Nederlandse indiening heeft als verplichte waarde een IfcProjectedCRS met attribuut VerticalDatum EPSG:7415 (RD+NAP)of EPSG:28992 (RD) én EPSG:5709 (NAP)&#xA;https://www.opengis.net/def/crs/EPSG/0/28992">
          <ids:name>
            <ids:simpleValue>Name</ids:simpleValue>
          </ids:name>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:enumeration value="EPSG:7415" />
              <xs:enumeration value="EPSG:28992" />
            </xs:restriction>
          </ids:value>
        </ids:attribute>
      </ids:requirements>
    </ids:specification>
    <ids:specification ifcVersion="IFC4 IFC4X3_ADD2" name="9.01b Georefentie met IfcMapconversion" description="Aanbeveling 01:&#xA;Deze CRS-eis geldtDeze CRS-eis geldt alleen voor Nederlandse projecten waarbij de omvang van het project i.c.m. de kromming van de aarde geen probleem oplevert. Als dit niet geldt dan is het ook mogelijk om eventueel IfcGeographicCRS en/of andere EPSG te gebruiken." instructions="Requirement 02:&#xA;Een BIM-Model moet de IFCClass IFCMAPCONVERSION bevatten met de attributen SourceCRS, TargetCRS, Easting, Northing, OrthogonalHeight, XAxisAbscissa, XAxisOrdinate en Scale ingevuld.&#xA;">
      <ids:applicability minOccurs="1" maxOccurs="unbounded">
        <ids:entity>
          <ids:name>
            <ids:simpleValue>IFCMAPCONVERSION</ids:simpleValue>
          </ids:name>
        </ids:entity>
      </ids:applicability>
      <ids:requirements>
        <ids:attribute cardinality="required" instructions="Het broncoördinatenstelsel van het BIM-model&#xA;Voorbeeld: IfcGeometric-RepresentationContext">
          <ids:name>
            <ids:simpleValue>SourceCRS</ids:simpleValue>
          </ids:name>
        </ids:attribute>
        <ids:attribute cardinality="required" instructions="Doel coördinatenstelsel waarin het BIM-model geplaatst wordt.&#xA;EPSG 7415&#xA;&#xA;Het attribuut TargetCRS voor Nederlandse indiening heeft als verplichte waarde een IfcProjectedCRS met attribuut VerticalDatum EPSG:7415 (RD+NAP)of EPSG:28992 (RD) én EPSG:5709 (NAP)">
          <ids:name>
            <ids:simpleValue>TargetCRS</ids:simpleValue>
          </ids:name>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:enumeration value="EPSG:7415" />
              <xs:enumeration value="EPSG:28992" />
            </xs:restriction>
          </ids:value>
        </ids:attribute>
        <ids:attribute cardinality="required" instructions="Verplaatsing in Oostrichting om het BIM-model op de goede plek te krijgen.&#xA;Voorbeeld: 92370.710706">
          <ids:name>
            <ids:simpleValue>Eastings</ids:simpleValue>
          </ids:name>
        </ids:attribute>
        <ids:attribute cardinality="required" instructions="Verplaatsing in Noordrichting om het BIM-model op de goede plek te krijgen.&#xA;Voorbeeld: 437455.379788">
          <ids:name>
            <ids:simpleValue>Northings</ids:simpleValue>
          </ids:name>
        </ids:attribute>
        <ids:attribute cardinality="required" instructions="Verplaatsing in Hoogterichting om het BIM-model op de goede plek te krijgen.&#xA;Voorbeeld: 1.3092">
          <ids:name>
            <ids:simpleValue>OrthogonalHeight</ids:simpleValue>
          </ids:name>
        </ids:attribute>
        <ids:attribute cardinality="required" instructions="Specificeert de waarde langs de oostelijke as van het eindpunt van een vector die de positie van de lokale x-as van het engineering coördinaatreferentiesysteem aangeeft.&#xA;Voorbeeld: 0.8">
          <ids:name>
            <ids:simpleValue>XAxisAbscissa</ids:simpleValue>
          </ids:name>
        </ids:attribute>
        <ids:attribute cardinality="required" instructions="Specificeert de waarde langs de oostelijke as van het eindpunt van een vector die de positie van de lokale x-as van het engineering coördinaatreferentiesysteem aangeeft.&#xA;Voorbeeld: 0.1">
          <ids:name>
            <ids:simpleValue>XAxisOrdinate</ids:simpleValue>
          </ids:name>
        </ids:attribute>
        <ids:attribute cardinality="required" instructions="Schaal van eenheden in BIM-model t.o.v. eenheden in target CRS&#xA;Voorbeeld: 1/0.001">
          <ids:name>
            <ids:simpleValue>Scale</ids:simpleValue>
          </ids:name>
        </ids:attribute>
      </ids:requirements>
    </ids:specification>
    <ids:specification ifcVersion="IFC4 IFC4X3_ADD2" name="9.02 Project met IfcProject (units in context)" identifier="The full geo-referencing model for IFC. | Download Scientific Diagram (researchgate.net) https://www.researchgate.net/figure/The-full-geo-referencing-model-for-IFC_fig8_351907369" instructions="Requirement 03: Een BIM-Model moet de IFCClass IFCPROJECT bevatten zodat men de representationcontext heeft waar men t.o.v. IFCMAPCONVERSION de Local placement gedaan kan worden.">
      <ids:applicability minOccurs="1" maxOccurs="unbounded">
        <ids:entity>
          <ids:name>
            <ids:simpleValue>IFCPROJECT</ids:simpleValue>
          </ids:name>
        </ids:entity>
      </ids:applicability>
      <ids:requirements>
        <ids:entity instructions="Eigenaar BIM-model&#xA;Voorbeeld: Modelleur x">
          <ids:name>
            <xs:restriction base="xs:string">
              <xs:enumeration value="IFCORGANIZATION" />
              <xs:enumeration value="IFCPERSON" />
            </xs:restriction>
          </ids:name>
        </ids:entity>
        <ids:partOf relation="IFCRELCONTAINEDINSPATIALSTRUCTURE" cardinality="required" instructions="ObjectType: Bouwwerkperceel&#xA;https://iplo.nl/regelgeving/woordenlijst/bouwwerkperceel&#xA;">
          <ids:entity>
            <ids:name>
              <ids:simpleValue>IFCSPATIALZONE</ids:simpleValue>
            </ids:name>
            <ids:predefinedType>
              <ids:simpleValue>USERDEFINED</ids:simpleValue>
            </ids:predefinedType>
          </ids:entity>
        </ids:partOf>
        <ids:partOf relation="IFCRELCONTAINEDINSPATIALSTRUCTURE" cardinality="required" instructions="Naar een IfcSpatialZone met USERDEFINED ObjectType: Bouwwerkperceel https://iplo.nl/regelgeving/woordenlijst/bouwwerkperceel">
          <ids:entity>
            <ids:name>
              <ids:simpleValue>IFCSPATIALZONE</ids:simpleValue>
            </ids:name>
            <ids:predefinedType>
              <ids:simpleValue>USERDEFINED</ids:simpleValue>
            </ids:predefinedType>
          </ids:entity>
        </ids:partOf>
        <ids:partOf cardinality="required" instructions="? check hulpvraag - Deze lukt mij niet. IfcRel-AssignsTo-Actor, Optioneel Projectontwikkelaar/initiator aanvraag, Ontwikkelaar x">
          <ids:entity>
            <ids:name>
              <ids:simpleValue>IFCACTOR</ids:simpleValue>
            </ids:name>
          </ids:entity>
        </ids:partOf>
        <ids:attribute cardinality="optional" instructions="Naam&#xA;Voorbeeld: Woningbouwproject x">
          <ids:name>
            <ids:simpleValue>Name</ids:simpleValue>
          </ids:name>
        </ids:attribute>
        <ids:attribute cardinality="optional" instructions="Toelichting&#xA;Voorbeeld: Bouw van 5 rijwoningen">
          <ids:name>
            <ids:simpleValue>Description</ids:simpleValue>
          </ids:name>
        </ids:attribute>
        <ids:attribute cardinality="optional" instructions="Fase volgende STB2014: Voorbeeld: 05 Definitief ontwerp">
          <ids:name>
            <ids:simpleValue>Phase</ids:simpleValue>
          </ids:name>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:enumeration value="02 Projectdefinitie" />
              <xs:enumeration value="03 Structuurontwerp" />
              <xs:enumeration value="04 Voorontwerp" />
              <xs:enumeration value="07 Prijs- en Contractvorming" />
              <xs:enumeration value="10 Gebruik/Exploitatie" />
              <xs:enumeration value="01 Initiatief/haalbaarheid" />
              <xs:enumeration value="05 Definitief ontwerp" />
              <xs:enumeration value="07 Prijs- en contractvorming" />
              <xs:enumeration value="08 Uitvoering - Uitvoeringsgereed Ontwerp" />
              <xs:enumeration value="09 Uitvoering - Directievoering" />
              <xs:enumeration value="06 Technisch ontwerp/Bestek" />
            </xs:restriction>
          </ids:value>
        </ids:attribute>
        <ids:attribute cardinality="required" instructions="Eenheden&#xA;voorbeeld: m">
          <ids:name>
            <ids:simpleValue>UnitsInContext</ids:simpleValue>
          </ids:name>
        </ids:attribute>
        <ids:property uri="https://identifier.buildingsmart.org/uri/buildingsmart/ifc/4.3/prop/ProjectType" cardinality="optional">
          <ids:propertySet>
            <ids:simpleValue>Pset_ProjectCommon</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>ProjectType</ids:simpleValue>
          </ids:baseName>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:enumeration value="MODIFICATION" />
              <xs:enumeration value="NEWBUILD" />
              <xs:enumeration value="OPERATIONMAINTENANCE" />
              <xs:enumeration value="RENOVATION" />
              <xs:enumeration value="REPAIR" />
            </xs:restriction>
          </ids:value>
        </ids:property>
        <ids:property uri="https://identifier.buildingsmart.org/uri/buildingsmart/ifc/4.3/prop/ProjectInvestmentEstimate" cardinality="optional" instructions="Stichtingskosten: NEN2699 Niveau 1 : A t/m G&#xA;Voorbeeld: 1000000">
          <ids:propertySet>
            <ids:simpleValue>Pset_ProjectCommon</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>ProjectInvestmentEstimate</ids:simpleValue>
          </ids:baseName>
        </ids:property>
      </ids:requirements>
    </ids:specification>
    <ids:specification ifcVersion="IFC4 IFC4X3_ADD2" name="9.03 Bouwwerkperceel met IfcSpatialZone of IfcSpace [ipv ifcSite]" instructions="Requirement 04:&#xA;Een BIM-Model moet minimaal 1 IFCClass IFCSPATIALZONE.USERDEFINED bevatten van het ObjectType Bouwwerkperceel (iplo) óf objecttype Kadastraal perceel.&#xA;Deze bevat verplicht de attributen: Description, Objecttype, Objectplacement, Representation.&#xA;&#xA;Requirement 5:&#xA;Wanneer een BIM-Model meerdere bouwwerk- of kadastraalpercelen bevat dient de relatie IfcRelReferencedInSpatialStructure aan te geven welk perceel in een ander perceel zit.">
      <ids:applicability minOccurs="1" maxOccurs="unbounded">
        <ids:entity>
          <ids:name>
            <xs:restriction base="xs:string">
              <xs:enumeration value="IFCSPATIALZONE" />
              <xs:enumeration value="IFCSPACE" />
            </xs:restriction>
          </ids:name>
        </ids:entity>
        <ids:attribute>
          <ids:name>
            <ids:simpleValue>ObjectType</ids:simpleValue>
          </ids:name>
          <ids:value>
            <ids:simpleValue>Bouwwerk-Perceel</ids:simpleValue>
          </ids:value>
        </ids:attribute>
      </ids:applicability>
      <ids:requirements>
        <ids:partOf relation="IFCRELCONTAINEDINSPATIALSTRUCTURE" cardinality="required">
          <ids:entity>
            <ids:name>
              <xs:restriction base="xs:string">
                <xs:enumeration value="IFCBUILDING" />
                <xs:enumeration value="IFCSPATIALZONE" />
              </xs:restriction>
            </ids:name>
          </ids:entity>
        </ids:partOf>
        <ids:partOf relation="IFCRELCONTAINEDINSPATIALSTRUCTURE" cardinality="required" instructions="indien gebouw kleiner dan bouwwerk/kadaster perceel">
          <ids:entity>
            <ids:name>
              <ids:simpleValue>IFCBUILDING</ids:simpleValue>
            </ids:name>
          </ids:entity>
        </ids:partOf>
        <ids:partOf relation="IFCRELCONTAINEDINSPATIALSTRUCTURE" cardinality="required" instructions="indien gebouw groter dan bouwwerk/kadaster perceel">
          <ids:entity>
            <ids:name>
              <ids:simpleValue>IFCSPATIALZONE</ids:simpleValue>
            </ids:name>
          </ids:entity>
        </ids:partOf>
        <ids:partOf relation="IFCRELCONTAINEDINSPATIALSTRUCTURE" cardinality="required" instructions="IfcRelReferencedInSpatialStructure&#xA;Verplicht wanneer meerdere percelen aanwezig &#xA;Relatie naar gebouw of andere percelen binnen het perceel">
          <ids:entity>
            <ids:name>
              <xs:restriction base="xs:string">
                <xs:enumeration value="IFCPROJECT" />
                <xs:enumeration value="IFCSPATIALZONE" />
                <xs:enumeration value="IFCZONE" />
              </xs:restriction>
            </ids:name>
          </ids:entity>
        </ids:partOf>
        <ids:attribute cardinality="required" instructions="Bepalingsmethode&#xA;voorbeeld: TerreinVolume">
          <ids:name>
            <ids:simpleValue>Description</ids:simpleValue>
          </ids:name>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:enumeration value="Terreinvolume" />
              <xs:enumeration value="Onbebouwd terreinvolume" />
              <xs:enumeration value="Overbouwd terreinvolume" />
              <xs:enumeration value="Onderbouwd terreinvolume" />
              <xs:enumeration value="Bebouwd terreinvolume" />
              <xs:enumeration value="Netto inhoud" />
              <xs:enumeration value="Bruto inhoud" />
              <xs:enumeration value="Tarra inhoud" />
              <xs:enumeration value="Gebruiksinhoud" />
              <xs:enumeration value="Verhuurbare inhoud" />
              <xs:enumeration value="Nuttige inhoud" />
              <xs:enumeration value="Funcitoneel nuttige inhoud" />
              <xs:enumeration value="Programma van Eisen inhoud" />
            </xs:restriction>
          </ids:value>
        </ids:attribute>
        <ids:attribute cardinality="required" instructions="Beschrijving van het soort buitenruimte">
          <ids:name>
            <ids:simpleValue>ObjectType</ids:simpleValue>
          </ids:name>
          <ids:value>
            <ids:simpleValue>Bouwwerkperceel</ids:simpleValue>
          </ids:value>
        </ids:attribute>
        <ids:attribute cardinality="required" instructions="De plaatsing van het bouwwerkperceel&#xA;Voorbeeld: IfcObjectPlacement">
          <ids:name>
            <ids:simpleValue>ObjectPlacement</ids:simpleValue>
          </ids:name>
        </ids:attribute>
        <ids:attribute cardinality="required" instructions="De vorm van het bouwwerkperceel&#xA;Voorbeeld: IfcProductRepresentation">
          <ids:name>
            <ids:simpleValue>Representation</ids:simpleValue>
          </ids:name>
        </ids:attribute>
        <ids:attribute cardinality="optional" instructions="Unieke naam voor het bouwwerkperceel in communicatie&#xA;Woningbouwprojectperceel x">
          <ids:name>
            <ids:simpleValue>Name</ids:simpleValue>
          </ids:name>
        </ids:attribute>
        <ids:attribute cardinality="optional" instructions="De vrij te kiezen eigen naam van het bouwwerkperceel">
          <ids:name>
            <ids:simpleValue>LongName</ids:simpleValue>
          </ids:name>
        </ids:attribute>
      </ids:requirements>
    </ids:specification>
    <ids:specification ifcVersion="IFC4 IFC4X3_ADD2" name="9.04 KadastraalPerceel met IfcSpatialZone of IfcSpace" description="Aanbeveling 02:&#xA;De properties IfcLandID en IfcIsPermanentID zijn alleen voor IfcSite beschikbaar. Deze kunnen als propertyset aangemaakt worden voor deze IfcSpatialZone." instructions="Requirement 06:&#xA;Wanneer en BIM-model een kadastraalperceel bevat gelden bovenop requirement 4 en 5 ook de verplichte properties IfcLandID en IfcIsPermanentID.">
      <ids:applicability minOccurs="0" maxOccurs="unbounded">
        <ids:entity>
          <ids:name>
            <xs:restriction base="xs:string">
              <xs:enumeration value="IFCSPATIALZONE" />
              <xs:enumeration value="IFCSPACE" />
            </xs:restriction>
          </ids:name>
        </ids:entity>
        <ids:attribute>
          <ids:name>
            <ids:simpleValue>ObjectType</ids:simpleValue>
          </ids:name>
          <ids:value>
            <ids:simpleValue>Kadastraal-Perceel</ids:simpleValue>
          </ids:value>
        </ids:attribute>
      </ids:applicability>
      <ids:requirements>
        <ids:attribute cardinality="optional" instructions="Name&#xA;Optioneel Naam&#xA;Woningbouwproject x">
          <ids:name>
            <ids:simpleValue>Name</ids:simpleValue>
          </ids:name>
        </ids:attribute>
        <ids:attribute cardinality="required" instructions="Bepalingsmethode tablel 9.19.1 Terreinvolume, Onbebouwd terreinvolume, Overbouwd terreinvolume, Onderbouwd terreinvolume, Bebouwd terreinvolume, Bruto Inhoud, Netto inhoud, Tarra inhoud, Gebruiksinhoud, Verhuurbare inhoud, Nuttige Inhoud, Funcitoneel nuttige inhoud, Programma van Eisen inhoud,">
          <ids:name>
            <ids:simpleValue>Description</ids:simpleValue>
          </ids:name>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:enumeration value="Terreinvolume" />
              <xs:enumeration value="Onbebouwd terreinvolume" />
              <xs:enumeration value="Overbouwd terreinvolume" />
              <xs:enumeration value="Onderbouwd terreinvolume" />
              <xs:enumeration value="Bebouwd terreinvolume" />
              <xs:enumeration value="Netto inhoud" />
              <xs:enumeration value="Bruto inhoud" />
              <xs:enumeration value="Tarra inhoud" />
              <xs:enumeration value="Gebruiksinhoud" />
              <xs:enumeration value="Verhuurbare inhoud" />
              <xs:enumeration value="Nuttige inhoud" />
              <xs:enumeration value="Funcitoneel nuttige inhoud" />
              <xs:enumeration value="Programma van Eisen inhoud" />
            </xs:restriction>
          </ids:value>
        </ids:attribute>
        <ids:attribute cardinality="required" instructions="Beschrijving van het soort buitenruimte">
          <ids:name>
            <ids:simpleValue>ObjectType</ids:simpleValue>
          </ids:name>
          <ids:value>
            <ids:simpleValue>Kadastraal-Perceel</ids:simpleValue>
          </ids:value>
        </ids:attribute>
        <ids:attribute cardinality="required">
          <ids:name>
            <ids:simpleValue>ObjectPlacement</ids:simpleValue>
          </ids:name>
        </ids:attribute>
        <ids:attribute cardinality="required" instructions="Representation&#xA;Verplicht De vorm van het Kadastraalperceel&#xA;IfcProductRepresentation">
          <ids:name>
            <ids:simpleValue>Representation</ids:simpleValue>
          </ids:name>
        </ids:attribute>
        <ids:attribute cardinality="optional">
          <ids:name>
            <ids:simpleValue>LongName</ids:simpleValue>
          </ids:name>
        </ids:attribute>
        <ids:property dataType="IFCBOOLEAN" uri="https://identifier.buildingsmart.org/uri/buildingsmart/ifc/4.3/prop/IsPermanentID" cardinality="required">
          <ids:propertySet>
            <ids:simpleValue>Pset_LandRegistration</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>IsPermanentID</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property dataType="IFCLABEL" uri="https://identifier.buildingsmart.org/uri/buildingsmart/ifc/4.3/prop/LandID" cardinality="required">
          <ids:propertySet>
            <ids:simpleValue>Pset_LandRegistration</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>LandID</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property dataType="IFCLABEL" uri="https://identifier.buildingsmart.org/uri/buildingsmart/ifc/4.3/prop/LandTitleID" cardinality="optional">
          <ids:propertySet>
            <ids:simpleValue>Pset_LandRegistration</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>LandTitleID</ids:simpleValue>
          </ids:baseName>
        </ids:property>
      </ids:requirements>
    </ids:specification>
    <ids:specification ifcVersion="IFC4 IFC4X3_ADD2" name="9.05 Gebouw met IfcBuilding" identifier="Stel het lukt iemand om 3 gebouwen in 1 IFC te maken, dan kan het in 1 model. &#xA;&#xA;Zo niet dan 3 modellen bij het voorbeeld van de gezamelijke parkeergarage + twee woontorens erop.&#xA;(voorlopig uitgangspunt)" description="Aanbeveling 03:&#xA;Let op! Er kunnen meerdere gebouwen zijn in één project met een andere market (sub)category. Bij meerdere IFC’s is dit mogelijk. Een gebouw, bestaande uit twee woontoren en een parkeergarage zijn dus drie losse ifc-files met een building aan elkaar gelinkt." instructions="Requirement 07:&#xA;Een BIM-Model voor de activiteit “Nieuw gebouw bouwen” dient minimaal 1 IFCClass IFCBuilding te bevatten met de attributen: Description, Objecttype, Objectplacement, Representation.&#xA;En de properties: BuildingID, IsPermanentID, MarketCategory en MarketSubCategory.&#xA;Tenslotte bevat het gebouw minimaal 1 relatie IfcRelAggregates naar een gebouwverdieping.">
      <ids:applicability minOccurs="1" maxOccurs="unbounded">
        <ids:entity>
          <ids:name>
            <ids:simpleValue>IFCBUILDING</ids:simpleValue>
          </ids:name>
        </ids:entity>
      </ids:applicability>
      <ids:requirements>
        <ids:partOf relation="IFCRELAGGREGATES" cardinality="required">
          <ids:entity>
            <ids:name>
              <ids:simpleValue>IFCBUILDINGSTOREY</ids:simpleValue>
            </ids:name>
          </ids:entity>
        </ids:partOf>
        <ids:attribute cardinality="optional">
          <ids:name>
            <ids:simpleValue>Name</ids:simpleValue>
          </ids:name>
        </ids:attribute>
        <ids:attribute cardinality="required" instructions="Bepalingsmethode:&#xA;9.19.1 Enumeratie bepalingsmethode (NEN2580)&#xA;Terreinvolume Onbebouwd terreinvolume Overbouwd terreinvolume&#xA;Onderbouwd terreinvolume Bebouwd terreinvolume Bruto-Inhoud&#xA;Netto inhoud Tarra inhoud Gebruiksinhoud&#xA;Verhuurbare inhoud Nuttige Inhoud Funcitoneel nuttige inhoud&#xA;Programma van Eisen inhoud">
          <ids:name>
            <ids:simpleValue>Description</ids:simpleValue>
          </ids:name>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:enumeration value="Terreinvolume" />
              <xs:enumeration value="Onbebouwd terreinvolume" />
              <xs:enumeration value="Overbouwd terreinvolume" />
              <xs:enumeration value="Onderbouwd terreinvolume" />
              <xs:enumeration value="Bebouwd terreinvolume" />
              <xs:enumeration value="Netto inhoud" />
              <xs:enumeration value="Bruto inhoud" />
              <xs:enumeration value="Tarra inhoud" />
              <xs:enumeration value="Gebruiksinhoud" />
              <xs:enumeration value="Verhuurbare inhoud" />
              <xs:enumeration value="Nuttige inhoud" />
              <xs:enumeration value="Funcitoneel nuttige inhoud" />
              <xs:enumeration value="Programma van Eisen inhoud" />
            </xs:restriction>
          </ids:value>
        </ids:attribute>
        <ids:attribute cardinality="optional" instructions="Beschrijving van het soort IfcBuilding&#xA;Voorbeeld: Pand, Rijwoning, Appartement">
          <ids:name>
            <ids:simpleValue>ObjectType</ids:simpleValue>
          </ids:name>
        </ids:attribute>
        <ids:attribute cardinality="required" instructions="De plaatsing van het gebouw">
          <ids:name>
            <ids:simpleValue>ObjectPlacement</ids:simpleValue>
          </ids:name>
        </ids:attribute>
        <ids:attribute cardinality="required" instructions="De vorm van het gebouw">
          <ids:name>
            <ids:simpleValue>Representation</ids:simpleValue>
          </ids:name>
        </ids:attribute>
        <ids:attribute cardinality="optional">
          <ids:name>
            <ids:simpleValue>LongName</ids:simpleValue>
          </ids:name>
        </ids:attribute>
        <ids:attribute cardinality="optional" instructions="Adres van het gebouw, wordt niet gebruik voor georeferentie, puur ter info">
          <ids:name>
            <ids:simpleValue>SiteAddress</ids:simpleValue>
          </ids:name>
        </ids:attribute>
        <ids:property dataType="IFCIDENTIFIER" uri="https://identifier.buildingsmart.org/uri/buildingsmart/ifc/4.3/prop/BuildingID" cardinality="required" instructions="Gebouw-werk-ID of BAG-Pand-ID wanneer beschikbaar (Uit pset_buildingCommon) &#xA;voorbeeld: 003100000122684&#xA;Als dit een BAGPAND ID is dan staat de  IsPermanentID op True, zo niet  dan False">
          <ids:propertySet>
            <ids:simpleValue>Pset_BuildingCommon</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>BuildingID</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property dataType="IFCBOOLEAN" uri="https://identifier.buildingsmart.org/uri/buildingsmart/ifc/4.3/prop/IsPermanentID" cardinality="required" instructions="Als Building ID het BAGPAND ID is, dan staat de IsPermanentID op True, zo niet dan False">
          <ids:propertySet>
            <ids:simpleValue>Pset_BuildingCommon</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>IsPermanentID</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property dataType="IFCLABEL" uri="https://identifier.buildingsmart.org/uri/buildingsmart/ifc/4.3/prop/MarketCategory" cardinality="required" instructions="Duiding van soort gebouw zie enumeratie (gebouwtype) &gt; zie ennummeratie gebouwtype&#xA;Voorbeeld: Woongebouw&#xA;Bron: Geonovum.github.io/disgeo-inhoud-2/#-gebouw&#xA;Kantoor op basis van: kantorengebouwn-in-nl-1945-2015">
          <ids:propertySet>
            <ids:simpleValue>Pset_BuildingUse</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>MarketCategory</ids:simpleValue>
          </ids:baseName>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:enumeration value="Woongebouw" />
              <xs:enumeration value="Kantoorgebouw" />
              <xs:enumeration value="Bijgebouw" />
              <xs:enumeration value="Gebedsgebouw" />
              <xs:enumeration value="Vestigingsgebouw" />
              <xs:enumeration value="Bedrijfsgebouw" />
              <xs:enumeration value="Doelgroepengebouw" />
              <xs:enumeration value="Installatiegebouw" />
              <xs:enumeration value="Recreatiegebouw" />
              <xs:enumeration value="Toren" />
            </xs:restriction>
          </ids:value>
        </ids:property>
        <ids:property dataType="IFCLABEL" uri="https://identifier.buildingsmart.org/uri/buildingsmart/ifc/4.3/prop/MarketSubCategory" cardinality="required" instructions="ennummeratiue van 9.19.5&#xA;Woongebouw: Aanleunwoning Aireywoning Ambtswoning Arbeiderswoning Bejaardenwoning Bungalow Drive-inwoning Twee-onder-een-kapwoning Duplexwoning Grachtenpand Herenhuis Hoekwoning Paalwoning Pastorie Patiowoning Portiekwoning Schakelwoning Vrijstaand huis Appartement Bel-etagewoning Loft Maisonette Woontoren&#xA;Kantoorgebouw: Witte boorden fabrieken Representatief werkpaleis Cellenkantoor Kantoortuin Flexibel verhuurkantoor Hoogbouwkantoor &#xA;Bijgebouw: Garage Schuur&#xA;Gebedsgebouw: Kapel Kerkgebouw Klooster Moskee Synagoge Tempel &#xA;Vestigingsgebouw Bunker Fort Kasteel &#xA;Bedrijfsgebouw Boerderij Fabriek Hangar Kas Loods Molen Stal Voertuigenstalling &#xA;Doelgroepengebouw: Gevangenis Kazerne &#xA;Installatiegebouw: Energiecentrale Gemaalgebouw &#xA;Recreatiegebouw: Sportgebouw &#xA;Toren: Fabrieksschoorsteen Klokkentoren Vuurtoren Watertoren &#xA;">
          <ids:propertySet>
            <ids:simpleValue>Pset_BuildingUse</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>MarketSubCategory</ids:simpleValue>
          </ids:baseName>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:enumeration value="Aanleunwoning" />
              <xs:enumeration value="Aireywoning" />
              <xs:enumeration value="Ambtswoning" />
              <xs:enumeration value="Arbeiderswoning" />
              <xs:enumeration value="Bejaardenwoning" />
              <xs:enumeration value="Bungalow" />
              <xs:enumeration value="Drive-inwoning" />
              <xs:enumeration value="Twee-onder-een-kapwoning" />
              <xs:enumeration value="Duplexwoning" />
              <xs:enumeration value="Grachtenpand" />
              <xs:enumeration value="Herenhuis" />
              <xs:enumeration value="Hoekwoning" />
              <xs:enumeration value="Paalwoning" />
              <xs:enumeration value="Pastorie" />
              <xs:enumeration value="Patiowoning" />
              <xs:enumeration value="Portiekwoning" />
              <xs:enumeration value="Schakelwoning" />
              <xs:enumeration value="Vrijstaand huis" />
              <xs:enumeration value="Appartement" />
              <xs:enumeration value="Bel-etagewoning" />
              <xs:enumeration value="Loft" />
              <xs:enumeration value="Maisonette" />
              <xs:enumeration value="Woontoren" />
              <xs:enumeration value="Witte boorden fabrieken" />
              <xs:enumeration value="Representatief werkpaleis" />
              <xs:enumeration value="Cellenkantoor" />
              <xs:enumeration value="Kantoortuin" />
              <xs:enumeration value="Flexibel verhuurkantoor" />
              <xs:enumeration value="Hoogbouwkantoor" />
              <xs:enumeration value="Garage" />
              <xs:enumeration value="Schuur" />
              <xs:enumeration value="Bunker" />
              <xs:enumeration value="Fort" />
              <xs:enumeration value="Kasteel" />
              <xs:enumeration value="Boerderij" />
              <xs:enumeration value="Fabriek" />
              <xs:enumeration value="Hangar" />
              <xs:enumeration value="Kas" />
              <xs:enumeration value="Loods" />
              <xs:enumeration value="Molen" />
              <xs:enumeration value="Stal" />
              <xs:enumeration value="Voertuigenstalling" />
              <xs:enumeration value="Gevangenis" />
              <xs:enumeration value="Kazerne" />
              <xs:enumeration value="Energiecentrale" />
              <xs:enumeration value="Gemaalgebouw" />
              <xs:enumeration value="Sportgebouw" />
              <xs:enumeration value="Fabrieksschoorsteen" />
              <xs:enumeration value="Klokkentoren" />
              <xs:enumeration value="Vuurtoren" />
              <xs:enumeration value="Watertoren" />
            </xs:restriction>
          </ids:value>
        </ids:property>
      </ids:requirements>
    </ids:specification>
    <ids:specification ifcVersion="IFC4 IFC4X3_ADD2" name="9.06 Eigendom- en gebruikseenheid met IfcZone, IfcSpatialZone of IfcSpace" description="Aanbeveling 04:&#xA;*Let op! Voor het modelleren van een eigendoms- &amp; gebruikseenheid is bepalingsmethode Bruto Inhoud gewenst zodat hier geen speculatie over kan bestaan." instructions="Requirement 08:&#xA;Een BIM-Model voor de activiteit “Nieuw gebouw bouwen” dient minimaal 1 IFCClass IFCZone of IfcSpatialZone te bevatten van het objecttype Eigendom- en gebruikseenheid met de attributen: Name, Description, Objecttype. Een verwijzing naar een ruimtelijk object met geometrie of een eigen geometrie is verplicht.">
      <ids:applicability minOccurs="1" maxOccurs="unbounded">
        <ids:entity>
          <ids:name>
            <xs:restriction base="xs:string">
              <xs:enumeration value="IFCZONE" />
              <xs:enumeration value="IFCSPATIALZONE" />
              <xs:enumeration value="IFCSPACE" />
              <xs:enumeration value="IFCEXTERNALSPATIALELEMENT" />
            </xs:restriction>
          </ids:name>
        </ids:entity>
        <ids:attribute>
          <ids:name>
            <ids:simpleValue>ObjectType</ids:simpleValue>
          </ids:name>
          <ids:value>
            <ids:simpleValue>Eigendom- en gebruikseenheid</ids:simpleValue>
          </ids:value>
        </ids:attribute>
      </ids:applicability>
      <ids:requirements>
        <ids:attribute cardinality="required" instructions="Naam van de eenheid&#xA;Voorbeeld Unit S-25 / Appartement 3&#xA;">
          <ids:name>
            <ids:simpleValue>Name</ids:simpleValue>
          </ids:name>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:minLength value="1" />
            </xs:restriction>
          </ids:value>
        </ids:attribute>
        <ids:attribute cardinality="required" instructions="Bepalingsmethode: (enum geldt ook voor alle situaties waar bepalingsmetihdd&#xA;Voorbeeld: Bruto-Inhoud etc. enummeratie (Terrein-volume, Onbebouwdterrein-volume, Bebouwdterrein-volume, Bruto-inhoud, Netto-inhoud, Tarra-inhoud, Gebruiks-inhoud, Verhuurbare-inhoud, Kadastrale-inhoud">
          <ids:name>
            <ids:simpleValue>Description</ids:simpleValue>
          </ids:name>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:enumeration value="Terreinvolume" />
              <xs:enumeration value="Onbebouwd terreinvolume" />
              <xs:enumeration value="Overbouwd terreinvolume" />
              <xs:enumeration value="Onderbouwd terreinvolume" />
              <xs:enumeration value="Bebouwd terreinvolume" />
              <xs:enumeration value="Netto inhoud" />
              <xs:enumeration value="Bruto inhoud" />
              <xs:enumeration value="Tarra inhoud" />
              <xs:enumeration value="Gebruiksinhoud" />
              <xs:enumeration value="Verhuurbare inhoud" />
              <xs:enumeration value="Nuttige inhoud" />
              <xs:enumeration value="Funcitoneel nuttige inhoud" />
              <xs:enumeration value="Programma van Eisen inhoud" />
            </xs:restriction>
          </ids:value>
        </ids:attribute>
        <ids:attribute cardinality="required" instructions="Beschrijving van het soort ruimte&#xA;">
          <ids:name>
            <ids:simpleValue>ObjectType</ids:simpleValue>
          </ids:name>
          <ids:value>
            <ids:simpleValue>Eigendom- en gebruikseenheid</ids:simpleValue>
          </ids:value>
        </ids:attribute>
        <ids:attribute cardinality="optional" instructions="Eenheids-beschrijving&#xA;Voorbeeld:Een appartement met schuur en parkeerplaats">
          <ids:name>
            <ids:simpleValue>LongName</ids:simpleValue>
          </ids:name>
        </ids:attribute>
      </ids:requirements>
    </ids:specification>
    <ids:specification ifcVersion="IFC4 IFC4X3_ADD2" name="9.06a Eigendom- en gebruikseenheid met IfcZone" description="Aanbeveling 04:&#xA;*Let op! Voor het modelleren van een eigendoms- &amp; gebruikseenheid is bepalingsmethode Bruto Inhoud gewenst zodat hier geen speculatie over kan bestaan." instructions="Requirement 08:&#xA;Een BIM-Model voor de activiteit “Nieuw gebouw bouwen” dient minimaal 1 IFCClass IFCZone of IfcSpatialZone te bevatten van het objecttype Eigendom- en gebruikseenheid met de attributen: Name, Description, Objecttype. Een verwijzing naar een ruimtelijk object met geometrie of een eigen geometrie is verplicht.">
      <ids:applicability minOccurs="0" maxOccurs="unbounded">
        <ids:entity>
          <ids:name>
            <ids:simpleValue>IFCZONE</ids:simpleValue>
          </ids:name>
        </ids:entity>
        <ids:attribute>
          <ids:name>
            <ids:simpleValue>ObjectType</ids:simpleValue>
          </ids:name>
          <ids:value>
            <ids:simpleValue>Eigendom- en gebruikseenheid</ids:simpleValue>
          </ids:value>
        </ids:attribute>
      </ids:applicability>
      <ids:requirements>
        <ids:partOf relation="IFCRELASSIGNSTOGROUP" cardinality="required">
          <ids:entity>
            <ids:name>
              <xs:restriction base="xs:string">
                <xs:enumeration value="IFCSPACE" />
                <xs:enumeration value="IFCSPATIALZONE" />
                <xs:enumeration value="IFCZONE" />
                <xs:enumeration value="IFCEXTERNALSPATIALELEMENT" />
              </xs:restriction>
            </ids:name>
          </ids:entity>
        </ids:partOf>
        <ids:property dataType="IFCLABEL" uri="https://identifier.buildingsmart.org/uri/buildingsmart/ifc/4.3/prop/ActorCategory" cardinality="optional">
          <ids:propertySet>
            <ids:simpleValue>Pset_ActorCommon</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>Actor Category [ActorCategory]</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property dataType="IFCINTEGER" uri="https://identifier.buildingsmart.org/uri/buildingsmart/ifc/4.3/prop/NumberOfActors" cardinality="optional">
          <ids:propertySet>
            <ids:simpleValue>Pset_ActorCommon</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>Number of Actors [NumberOfActors]</ids:simpleValue>
          </ids:baseName>
        </ids:property>
      </ids:requirements>
    </ids:specification>
    <ids:specification ifcVersion="IFC4 IFC4X3_ADD2" name="9.06b Eigendom- en gebruikseenheid met  IfcSpatialZone" description="Aanbeveling 04:&#xA;*Let op! Voor het modelleren van een eigendoms- &amp; gebruikseenheid is bepalingsmethode Bruto Inhoud gewenst zodat hier geen speculatie over kan bestaan." instructions="Requirement 09:&#xA;Wanneer een BIM-model een IFCSpatialZone bevat van het objecttype Eigendom- en gebruikseenheid bovenop 9.06 (Requirement 8) de attributen Objectplacement en representation.">
      <ids:applicability minOccurs="0" maxOccurs="unbounded">
        <ids:entity>
          <ids:name>
            <xs:restriction base="xs:string">
              <xs:enumeration value="IFCSPATIALZONE" />
              <xs:enumeration value="IFCSPACE" />
            </xs:restriction>
          </ids:name>
        </ids:entity>
        <ids:attribute>
          <ids:name>
            <ids:simpleValue>ObjectType</ids:simpleValue>
          </ids:name>
          <ids:value>
            <ids:simpleValue>Eigendom- en gebruikseenheid</ids:simpleValue>
          </ids:value>
        </ids:attribute>
      </ids:applicability>
      <ids:requirements>
        <ids:partOf relation="IFCRELASSIGNSTOGROUP" cardinality="required" instructions="Let op deze is ">
          <ids:entity>
            <ids:name>
              <ids:simpleValue>IFCZONE</ids:simpleValue>
            </ids:name>
          </ids:entity>
        </ids:partOf>
        <ids:partOf relation="IFCRELCONTAINEDINSPATIALSTRUCTURE" cardinality="required" instructions="We willen IfcRelRef eerst hebben ipv IfcRelCon">
          <ids:entity>
            <ids:name>
              <ids:simpleValue>IFCRELREFERENCEDINSPATIALSTRUCTURE</ids:simpleValue>
            </ids:name>
          </ids:entity>
        </ids:partOf>
        <ids:attribute cardinality="required">
          <ids:name>
            <ids:simpleValue>ObjectPlacement</ids:simpleValue>
          </ids:name>
        </ids:attribute>
        <ids:attribute cardinality="required">
          <ids:name>
            <ids:simpleValue>Representation</ids:simpleValue>
          </ids:name>
        </ids:attribute>
      </ids:requirements>
    </ids:specification>
    <ids:specification ifcVersion="IFC4 IFC4X3_ADD2" name="9.06c Eigendom- en gebruikseenheid met  IfcSpace" description="Aanbeveling 04:&#xA;*Let op! Voor het modelleren van een eigendoms- &amp; gebruikseenheid is bepalingsmethode Bruto Inhoud gewenst zodat hier geen speculatie over kan bestaan." instructions="Requirement 10:&#xA;Wanneer een BIM-model een IFCSpace bevat van het objecttype Eigendom- en gebruikseenheid bovenop requirement 8 de attributen Objectplacement en representation.">
      <ids:applicability minOccurs="0" maxOccurs="unbounded">
        <ids:entity>
          <ids:name>
            <ids:simpleValue>IFCSPACE</ids:simpleValue>
          </ids:name>
        </ids:entity>
        <ids:attribute>
          <ids:name>
            <ids:simpleValue>ObjectType</ids:simpleValue>
          </ids:name>
          <ids:value>
            <ids:simpleValue>Eigendom- en gebruikseenheid</ids:simpleValue>
          </ids:value>
        </ids:attribute>
      </ids:applicability>
      <ids:requirements>
        <ids:partOf relation="IFCRELAGGREGATES" cardinality="required">
          <ids:entity>
            <ids:name>
              <xs:restriction base="xs:string">
                <xs:enumeration value="IFCZONE" />
                <xs:enumeration value="IFCSPATIALZONE" />
                <xs:enumeration value="IFCSPACE" />
                <xs:enumeration value="IFCEXTERNALSPATIALELEMENT" />
              </xs:restriction>
            </ids:name>
          </ids:entity>
        </ids:partOf>
        <ids:attribute cardinality="required">
          <ids:name>
            <ids:simpleValue>ObjectPlacement</ids:simpleValue>
          </ids:name>
        </ids:attribute>
        <ids:attribute cardinality="required">
          <ids:name>
            <ids:simpleValue>Representation</ids:simpleValue>
          </ids:name>
        </ids:attribute>
      </ids:requirements>
    </ids:specification>
    <ids:specification ifcVersion="IFC4 IFC4X3_ADD2" name="9.07 Verdieping met IfcBuildingStorey" instructions="Requirement 11:&#xA;Een BIM-Model voor de activiteit “Nieuw gebouw bouwen” dient minimaal 1 IFCClass IFCBuildingStorey te hebben met de attributen Name, Description, Objecttype, Objecctplacement, Representation en IfcRelAggregates naar de gebouwruimte">
      <ids:applicability minOccurs="1" maxOccurs="unbounded">
        <ids:entity>
          <ids:name>
            <ids:simpleValue>IFCBUILDINGSTOREY</ids:simpleValue>
          </ids:name>
        </ids:entity>
      </ids:applicability>
      <ids:requirements>
        <ids:partOf relation="IFCRELAGGREGATES" cardinality="required">
          <ids:entity>
            <ids:name>
              <xs:restriction base="xs:string">
                <xs:enumeration value="IFCSPACE" />
                <xs:enumeration value="IFCSPATIALZONE" />
                <xs:enumeration value="IFCZONE" />
              </xs:restriction>
            </ids:name>
          </ids:entity>
        </ids:partOf>
        <ids:attribute cardinality="required" instructions="conform lijst BIM basis ILS - later invullen lex bijvoorbeeld  00 begane grond, 01 eerste verdieping">
