    <ids:specification ifcVersion="IFC4 IFC4X3_ADD2" name="9.16c Brandcompartiment, brandsubcompartiment en vluchtroute met IfcSpace" description="Aanbeveling 11:&#xA;Het gebruik van IfcZone is alleen mogelijk als er geen niet-dragende-separatiewanden&#xA;onderdeel zijn van het gebied of als onderdeel zijnde niet-dragende-separatiewanden&#xA;gemodelleerd zijn als IfcSpace of IfcSpatialZone (Bepalingsmethode Tarra Inhoud&#xA;Objecttype Tarra Ruimte)" instructions="Requirement 20:&#xA;Een BIM-Model voor de activiteit “Nieuw gebouw bouwen” dient minimaal 1 IfcClass&#xA;IfcZone of IfcSpatialZone te hebben van het objecttype Brandcompartiment. De attributen&#xA;Description en Objecttype zijn verplicht. Verwijzing naar object met geometrie of eigen&#xA;geometrie is verplicht.">
      <ids:applicability minOccurs="0" maxOccurs="unbounded">
        <ids:entity>
          <ids:name>
            <ids:simpleValue>IFCSPACE</ids:simpleValue>
          </ids:name>
        </ids:entity>
      </ids:applicability>
      <ids:requirements>
        <ids:partOf relation="IFCRELCONTAINEDINSPATIALSTRUCTURE" cardinality="required">
          <ids:entity>
            <ids:name>
              <ids:simpleValue>IFCRELREFERENCEDINSPATIALSTRUCTURE</ids:simpleValue>
            </ids:name>
          </ids:entity>
        </ids:partOf>
      </ids:requirements>
    </ids:specification>
    <ids:specification ifcVersion="IFC4 IFC4X3_ADD2" name="9.17 Niet-doorgaanbare ruimte (Tarra Ruimte)" instructions="Requirement 21:&#xA;Een BIM-Model voor de activiteit “Nieuw gebouw bouwen” waarbij men tarra ruimte&#xA;modelleert dient minimaal 1 IFCClass IfcSpatialZone te hebben van het objecttype Tarra-&#xA;Ruimte. De attributen Description en Objecttype zijn verplicht. Verwijzing naar object met&#xA;geometrie of eigen geometrie is verplicht.)">
      <ids:applicability minOccurs="1" maxOccurs="unbounded">
        <ids:entity>
          <ids:name>
            <ids:simpleValue>IFCSPATIALZONE</ids:simpleValue>
          </ids:name>
        </ids:entity>
        <ids:attribute>
          <ids:name>
            <ids:simpleValue>ObjectType</ids:simpleValue>
          </ids:name>
          <ids:value>
            <ids:simpleValue>Tarra-Ruimte</ids:simpleValue>
          </ids:value>
        </ids:attribute>
      </ids:applicability>
      <ids:requirements>
        <ids:attribute cardinality="optional">
          <ids:name>
            <ids:simpleValue>Name</ids:simpleValue>
          </ids:name>
        </ids:attribute>
        <ids:attribute cardinality="required" instructions="Bepalingsmethode">
          <ids:name>
            <ids:simpleValue>Description</ids:simpleValue>
          </ids:name>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:enumeration value="a" />
              <xs:enumeration value="b" />
            </xs:restriction>
          </ids:value>
        </ids:attribute>
        <ids:attribute cardinality="required" instructions="Beschrijving van het soort ruimte&#xA;(enumeratie BBL-ruimte)">
          <ids:name>
            <ids:simpleValue>ObjectType</ids:simpleValue>
          </ids:name>
          <ids:value>
            <ids:simpleValue>Tarra-Ruimte</ids:simpleValue>
          </ids:value>
        </ids:attribute>
        <ids:attribute cardinality="required" instructions="De plaatsing van de tarra-ruimte">
          <ids:name>
            <ids:simpleValue>ObjectPlacement</ids:simpleValue>
          </ids:name>
        </ids:attribute>
        <ids:attribute cardinality="required" instructions="De plaatsing van de tarra-ruimte">
          <ids:name>
            <ids:simpleValue>Representation</ids:simpleValue>
          </ids:name>
        </ids:attribute>
        <ids:attribute cardinality="required" instructions="De plaatsing van de tarra-ruimte">
          <ids:name>
            <ids:simpleValue>LongName</ids:simpleValue>
          </ids:name>
        </ids:attribute>
      </ids:requirements>
    </ids:specification>
    <ids:specification ifcVersion="IFC4 IFC4X3_ADD2" name="9.18 Fysieke elementen IfcSlab, IfcColumn, IfcBeam, IfcMember, IfcCurtainWall, IfcWall" instructions="Requirement 22:&#xA;Een BIM-Model voor de activiteit “Nieuw gebouw bouwen” dient minimaal 1 IFCClass van IfcSlab, IfcColumn, IfcBeam, IfcMember, IfcCurtainWall, IfcWall of met de pset_WallCommon,&#xA;pset_ColumCommon, pset_xCommon (Loadbearing is True). De attributen&#xA;Objectplacement en Representation zijn verplicht. De property LoadBearing is verplicht.&#xA;&#xA;Requirement 23:&#xA;Een BIM-Model voor de activiteit “Nieuw gebouw bouwen” dient minimaal 1 IFCClass van IfcSlab, IfcColumn, IfcBeam, IfcMember, IfcCurtainWall, IfcWall met de een Classificatie met verplicht het attribuut Name waarin de NL-SFB classificatie staat. De relatie ifcRelAssociatesClassification is in IDS een apart Facet">
      <ids:applicability minOccurs="1" maxOccurs="unbounded">
        <ids:entity>
          <ids:name>
            <ids:simpleValue>IFCWALL</ids:simpleValue>
          </ids:name>
        </ids:entity>
      </ids:applicability>
      <ids:requirements>
        <ids:classification cardinality="required">
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:pattern value="\d{2}\.\d{2}" />
            </xs:restriction>
          </ids:value>
          <ids:system>
            <ids:simpleValue>NL-SfB</ids:simpleValue>
          </ids:system>
        </ids:classification>
        <ids:attribute cardinality="optional">
          <ids:name>
            <ids:simpleValue>Name</ids:simpleValue>
          </ids:name>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:minLength value="1" />
            </xs:restriction>
          </ids:value>
        </ids:attribute>
        <ids:attribute cardinality="optional" instructions="Beschrijving van de wall">
          <ids:name>
            <ids:simpleValue>Description</ids:simpleValue>
          </ids:name>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:minLength value="1" />
            </xs:restriction>
          </ids:value>
        </ids:attribute>
        <ids:attribute cardinality="optional" instructions="Beschrijving van het soort wall&#xA;Voorbeeld: betonwand&#xA;https://identifier.buildingsmart.org/uri/volkerwesselsbvgo/basis_bouwproducten_oene/0.1/class/betonwand">
          <ids:name>
            <ids:simpleValue>ObjectType</ids:simpleValue>
          </ids:name>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:minLength value="1" />
            </xs:restriction>
          </ids:value>
        </ids:attribute>
        <ids:attribute cardinality="required" instructions="Verplicht De plaatsing van het element">
          <ids:name>
            <ids:simpleValue>ObjectPlacement</ids:simpleValue>
          </ids:name>
        </ids:attribute>
        <ids:attribute cardinality="required" instructions="De vorm van het compartiment">
          <ids:name>
            <ids:simpleValue>Representation</ids:simpleValue>
          </ids:name>
        </ids:attribute>
        <ids:attribute cardinality="required">
          <ids:name>
            <ids:simpleValue>LongName</ids:simpleValue>
          </ids:name>
        </ids:attribute>
      </ids:requirements>
    </ids:specification>
    <ids:specification ifcVersion="IFC4 IFC4X3_ADD2" name="9.18a Fysieke elementen IfcSlab" instructions="Requirement 22&#xA;Een BIM-Model voor de activiteit “Nieuw gebouw bouwen” dient minimaal 1 IFCClass van&#xA;IfcWall, IfcColumn, IfcCurtainWall of IfcMember met de pset_WallCommon,&#xA;pset_ColumCommon, pset_xCommon (Loadbearing is True). De attributen&#xA;objectplacement en representation zijn verplicht. De property loadbearing is verplicht.&#xA;&#xA;Requirement 23&#xA;Een BIM-Model voor de activiteit “Nieuw gebouw bouwen” dient minimaal 1 IFCClass van&#xA;IfcWall, IfcColumn, IfcCurtainWall of IfcMember met de de relatie&#xA;ifcRelAssociatesClassification te hebben naar een Classificatie-entiteit met verplicht het&#xA;attribuut Name waarin de NL-SFB classificatie staat.">
      <ids:applicability minOccurs="1" maxOccurs="unbounded">
        <ids:entity>
          <ids:name>
            <ids:simpleValue>IFCSLAB</ids:simpleValue>
          </ids:name>
        </ids:entity>
      </ids:applicability>
      <ids:requirements>
        <ids:property dataType="IFCLABEL" uri="https://identifier.buildingsmart.org/uri/buildingsmart/ifc/4.3/prop/AcousticRating" cardinality="optional">
          <ids:propertySet>
            <ids:simpleValue>Pset_SlabCommon</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>Acoustic Rating [AcousticRating]</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property dataType="IFCBOOLEAN" uri="https://identifier.buildingsmart.org/uri/buildingsmart/ifc/4.3/prop/Combustible" cardinality="optional">
          <ids:propertySet>
            <ids:simpleValue>Pset_SlabCommon</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>Combustible [Combustible]</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property dataType="IFCLABEL" uri="https://identifier.buildingsmart.org/uri/buildingsmart/ifc/4.3/prop/FireRating" cardinality="optional">
          <ids:propertySet>
