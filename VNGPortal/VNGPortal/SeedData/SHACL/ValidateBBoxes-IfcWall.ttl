@prefix shacl: <https://vng.nl/shacl/> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

shacl:ValidateBBoxes-IfcWall a shacl:Shape ;
    shacl:id "ValidateBBoxes-IfcWall" ;
    shacl:description """
This SHACL shape validates the bounding boxes of IFC walls.
1. geom:GeometryShape targets every instance of the class ifc:IfcWall (sh:targetClass).
2. A SPARQL-based constraint (sh:sparql) reads the bounding box values (geom:bboxMinX/Y/Z and geom:bboxMaxX/Y/Z) of each target and calculates the size per axis: deltaX = maxX - minX, deltaY = maxY - minY, deltaZ = maxZ - minZ.
3. A target is reported as a violation when any delta is smaller than 1 or larger than 100.
4. The result message contains the GlobalId and the three deltas ("BBox violation for GlobalId=[...]: deltaX=..., deltaY=..., deltaZ=..."). The 3D view uses the GlobalId=[...] part to find the geometry again.
5. The severity is sh:Violation.
""" ;
    shacl:shapeUri "validate-bboxes-ifcwall.ttl" ;
    shacl:views ( shacl:ValidateBBoxes-IfcWall-view-0 ) .

# ---------------------------------------------------------------- View 0
shacl:ValidateBBoxes-IfcWall-view-0 a shacl:View ;
    shacl:type "violation" ;
    shacl:visualization "3dview" ;
    shacl:queries (
        shacl:ValidateBBoxes-IfcWall-view-0-query-0
        shacl:ValidateBBoxes-IfcWall-view-0-query-1
    ) .

shacl:ValidateBBoxes-IfcWall-view-0-query-0 a shacl:Query ;
    shacl:id "RetrieveGeometryByGlobalIdTemplate" ;
    shacl:description """
Retrieves the geometry of the violating elements for the 3D view.
1. The placeholder ###GLOBAL_IDS_LIST### is replaced with the GlobalIds extracted from the violation messages. templateArgRegExpr matches GlobalId=[...] and the named group "globalId" provides the value.
2. VALUES restricts ?globalIdValue to those GlobalIds.
3. In the graph <https://vng.nl/geometries/> it returns the matching geom:base64Data, which is shown in the 3D view (geometryVariable = base64Data).
""" ;
    shacl:queryUri "retrieve-geometry-by-globalId-template.ttl" ;
    shacl:templateArgRegExpr "GlobalId=\\[(?<globalId>[^\\]]+)\\]" ;
    shacl:templateArgRegExprMatch "globalId" ;
    shacl:templateArgName "###GLOBAL_IDS_LIST###" ;
    shacl:geometryVariable "base64Data" ;
    shacl:zoomTo true .

shacl:ValidateBBoxes-IfcWall-view-0-query-1 a shacl:Query ;
    shacl:id "RetrieveLivingAreas" ;
    shacl:description """
Retrieves the living areas to show as context in the 3D view.
1. In the graph <areas.ttl> it selects every dso:area with its dso:id, dso:group and dso:geometry.
2. FILTER keeps only areas whose group is "wonen" (residential).
3. The result is ordered by ?id, and the geometry is shown in the 3D view (geometryVariable = geometry).
""" ;
    shacl:queryUri "retrieve-living-areas.ttl" ;
    shacl:geometryVariable "geometry" .