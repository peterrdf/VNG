@prefix shacl: <https://vng.nl/shacl/> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

shacl:ValidateTopologicalRelationsShape a shacl:Shape ;
    shacl:id "ValidateTopologicalRelationsShape" ;
    shacl:description """
        This SHACL shape validates the topological relation of geometries to the living areas.
        1. geom:GeometryShape targets every subject that has a geom:globalId (sh:targetSubjectsOf).
        2. A SPARQL-based constraint (sh:sparql) reads geom:globalId and geom:topologicalRelation of each target.
        3. A target is reported as a violation when geom:topologicalRelation is not "CONTAINED BY", which means the element is not fully inside the "wonen" (residential) areas.
        4. The result message is "geom:topologicalRelation is NOT 'CONTAINED BY'. GlobalId: ...".
        5. The severity is sh:Violation.
        """ ;
    shacl:shape """
@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix geom: <https://vng.nl/geometry/> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix ifc:  <https://standards.buildingsmart.org/IFC/DEV/IFC4/ADD2/OWL#> .

geom:GeometryShape
    a sh:NodeShape ;
    sh:targetClass ifc:IfcWall, ifc:IfcRoof ;
    sh:targetSubjectsOf geom:globalId ;

    sh:sparql [
        sh:prefixes [
            sh:declare [
                sh:prefix "geom" ;
                sh:namespace "https://vng.nl/geometry/"^^xsd:anyURI
            ] ;
            sh:declare [
                sh:prefix "rdf" ;
                sh:namespace "http://www.w3.org/1999/02/22-rdf-syntax-ns#"^^xsd:anyURI
            ]
        ] ;
        sh:select \"\"\"
            SELECT $this ?value ?globalId
            WHERE {
                $this geom:globalId              ?globalId ;
                      geom:topologicalRelation   ?value .
                FILTER(?value NOT IN ("CONTAINED BY", "INVALID INPUT"))
            }
        \"\"\" ;
        sh:message "geom:topologicalRelation is NOT 'CONTAINED BY'. GlobalId: {?globalId}" ;
    ] ;
    sh:severity sh:Violation .
""" .