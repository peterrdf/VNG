<?xml version="1.0" encoding="utf-8"?>
<sparql>
	<id><![CDATA[InsertTopologicalRelations]]></id>
	<!--
		Explanation:
		This SPARQL update computes and stores the topological relation between each
		IFC element's projected geometry and the "wonen" (residential) DSO areas.
		1. Finds every IFC element with an ifc:globalId_IfcRoot and reads its GlobalId string value.
		2. Matches the GlobalId to a ?geometry in the graph <https://vng.nl/geometries/>
		   (geom:globalId) and reads its geom:projectionBase64Data.
		3. In a sub-query, collects the geometries of all dso:area resources in the graph
		   <areas.ttl> whose dso:group is "wonen" and concatenates them into one
		   string (?allBase64), separated by "|".
		4. Calls the custom function vng:gmTopology with the element projection and the
		   concatenated area geometries to compute ?topologicalRelation.
		5. Optionally reads any existing geom:topologicalRelation (?oldRelation).
		6. Deletes the old relation and inserts the new one as geom:topologicalRelation
		   on the geometry, so re-running the query replaces stale values.
	-->
	<query uri="insert-topological-relations.ttl">
	</query>
</sparql>