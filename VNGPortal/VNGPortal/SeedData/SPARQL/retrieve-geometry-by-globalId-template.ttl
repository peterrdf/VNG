@prefix sp:  <https://vng.nl/sparql/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

sp:RetrieveGeometryByGlobalIdTemplate a sp:Query ;
    sp:id "RetrieveGeometryByGlobalIdTemplate" ;
    sp:parameters (
        [ a sp:Parameter ;
          sp:type "template" ;
          sp:regExpr "GlobalId=\\[(?<globalId>[^\\]]+)\\]" ;
          sp:regExprGroup "globalId" ;
          sp:target "###GLOBAL_IDS_LIST###" ]
        [ a sp:Parameter ; sp:type "geometry" ; sp:value "base64Data" ]
        [ a sp:Parameter ; sp:type "ui" ; sp:name "zoomTo" ; sp:value "true" ]
    ) ;
    sp:query """
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX geom: <https://vng.nl/geometry/>

SELECT ?globalIdValue ?base64Data
WHERE {
    VALUES ?globalIdValue { ###GLOBAL_IDS_LIST### }
    GRAPH <https://vng.nl/geometries/> {
        ?geometry   geom:globalId   ?globalIdValue ;
                    geom:base64Data ?base64Data .
    }
}
""" .