@prefix sp:  <https://vng.nl/sparql/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

sp:RetrieveTopologyViolations-IfcWall-IfcRoof a sp:Query ;
    sp:id "RetrieveTopologyViolations-IfcWall-IfcRoof" ;
    sp:description """
        Retrieves the geometry of the walls that violate the topological relation rule, for the 3D view.
        1. VALUES restricts ?ifcType to ifc:IfcWall and ifc:ifcRoof.
        2. Finds the IFC elements of that type with an ifc:globalId_IfcRoot and reads the GlobalId string value.
        3. In the graph <https://vng.nl/geometries/> it matches the geometry with the same rdf:type and geom:globalId, and reads geom:base64Data and geom:topologicalRelation.
        4. FILTER keeps only geometries whose relation is not "CONTAINED BY".
        5. The result is ordered by ?ifcElement, and the geometry is shown in the 3D view (geometryVariable = base64Data).
        """ ;
    sp:parameters (
        [ a sp:Parameter ; sp:type "geometry" ; sp:value "base64Data" ]
        [ a sp:Parameter ; sp:type "ui" ; sp:name "zoomTo" ; sp:value "true" ]
    ) ;
    sp:query """
PREFIX rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX ifc:     <https://standards.buildingsmart.org/IFC/DEV/IFC4/ADD2/OWL#>
PREFIX express: <https://w3id.org/express#>
PREFIX geom:    <https://vng.nl/geometry/>

SELECT ?ifcElement ?globalIdValue ?base64Data ?topologicalRelation
WHERE {
    VALUES ?ifcType { ifc:IfcWall ifc:IfcRoof }

    ?ifcElement     rdf:type                ?ifcType ;
                    ifc:globalId_IfcRoot    ?globalIdNode .
    ?globalIdNode   rdf:type                ifc:IfcGloballyUniqueId ;
                    express:hasString       ?globalIdValue .

    GRAPH <https://vng.nl/geometries/> {
        ?geometry   rdf:type                ?ifcType ;
                    geom:globalId           ?globalIdValue ;
                    geom:base64Data         ?base64Data ;
                    geom:topologicalRelation ?topologicalRelation .
        FILTER(?topologicalRelation NOT IN ("CONTAINED BY", "INVALID INPUT"))
    }
}
ORDER BY ?ifcElement
""" .