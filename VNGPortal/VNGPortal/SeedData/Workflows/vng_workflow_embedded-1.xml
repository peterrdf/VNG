		<step>
			<name><![CDATA[Insert Areas]]></name>
			<description>
				<![CDATA[
				    Retrieves residential ('wonen') planning zones based on the location of the building in the IFC model.
			    ]]>
			</description>
			<type><![CDATA[SPARQL]]></type>
			<parameters>
				<queryRef><![CDATA[InsertAreas]]></queryRef>
			</parameters>
		</step>
		<step>
			<name><![CDATA[Insert BBoxes]]></name>
			<description>
				<![CDATA[
			        Calculates the 3D bounding box for every geometry.
			    ]]>
			</description>
			<type><![CDATA[SPARQL]]></type>
			<parameters>
				<queryRef><![CDATA[InsertBBoxes]]></queryRef>
			</parameters>
		</step>
		<step>
			<name><![CDATA[Insert Projections]]></name>
			<description>
				<![CDATA[
			        Generates a 2D map projection for every 3D geometry.
			    ]]>
			</description>
			<type><![CDATA[SPARQL]]></type>
			<parameters>
				<queryRef><![CDATA[InsertProjections]]></queryRef>
			</parameters>
		</step>
		<step>
			<name><![CDATA[Insert Topological Relations]]></name>
			<description>
				<![CDATA[
			        Calculates whether every geometry in the building model spatially overlaps with residential ("wonen") planning zones.
			    ]]>
			</description>
			<type><![CDATA[SPARQL]]></type>
			<parameters>
				<queryRef><![CDATA[InsertTopologicalRelations]]></queryRef>
			</parameters>
		</step>
		<step>
			<name><![CDATA[Validate Topological Relations]]></name>
			<description>
				<![CDATA[
			        Validates that every geometry in the building is fully contained within residential ("wonen") planning zones.
			    ]]>
			</description>
			<type><![CDATA[SHACL]]></type>
			<parameters>
				<shapeRef><![CDATA[ValidateTopologicalRelations]]></shapeRef>
			</parameters>
		</step>
		<step>
			<name><![CDATA[Validate BBoxes]]></name>
			<description>
				<![CDATA[
			        Validates that every wall has a realistic physical size — not too small and not too large.
			    ]]>
			</description>
			<type><![CDATA[SHACL]]></type>
			<parameters>
				<shapeRef><![CDATA[ValidateBBoxes-IfcWall]]></shapeRef>
			</parameters>
		</step>
		<step>
			<name><![CDATA[Validate Model BBox]]></name>
			<description>
				<![CDATA[
			        Validates that the combined geometry of the entire building has a realistic size — not too small and not too large.
			    ]]>
			</description>
			<type><![CDATA[SHACL]]></type>
			<parameters>
				<shapeRef><![CDATA[ValidateModelBBoxes]]></shapeRef>
			</parameters>
		</step>
	</steps>
</workflow>