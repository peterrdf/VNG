@prefix wf:  <https://vng.nl/workflow/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

wf:workflow-11 a wf:Workflow ;
    wf:id 11 ;
    wf:name "Regel #11: Rc-waarde" ;
    wf:steps (
        wf:step-0  wf:step-1  wf:step-2  wf:step-3  wf:step-4
        wf:step-5  wf:step-6  wf:step-7  wf:step-8  wf:step-9
        wf:step-10 wf:step-11 wf:step-12
    ) .

wf:step-0 a wf:Step ;
    wf:id 0 ;
    wf:name "IDS Validation" ;
    wf:type "IDS" ;
    wf:idsFile "01-9-ILS-voor-Ruimten-in-de-omgevingswet.ids" .

wf:step-1 a wf:Step ;
    wf:id 1 ;
    wf:name "IDS Validation" ;
    wf:type "IDS" ;
    wf:idsFile "07-9.02-Project.ids" .

wf:step-2 a wf:Step ;
    wf:id 2 ;
    wf:name "IDS Validation" ;
    wf:type "IDS" ;
    wf:idsFile "10-9.04-Kadastraal-Perceel.ids" .

wf:step-3 a wf:Step ;
    wf:id 3 ;
    wf:name "IDS Validation" ;
    wf:type "IDS" ;
    wf:idsFile "16-9.08-Gebruiksfunctie.ids" .

wf:step-4 a wf:Step ;
    wf:id 4 ;
    wf:name "IDS Validation" ;
    wf:type "IDS" ;
    wf:idsFile "18-9.10a-Functiegebied.ids" .

wf:step-5 a wf:Step ;
    wf:id 5 ;
    wf:name "IDS Validation" ;
    wf:type "IDS" ;
    wf:idsFile "19-9.10b-Verblijfsgebied.ids" .

wf:step-6 a wf:Step ;
    wf:id 6 ;
    wf:name "IDS Validation" ;
    wf:type "IDS" ;
    wf:idsFile "36-9.18c-Fysieke-elementen-IfcCovering.INSULATION.ids" .

wf:step-7 a wf:Step ;
    wf:id 7 ;
    wf:name "IDS Validation" ;
    wf:type "IDS" ;
    wf:idsFile "37-9.18d-Fysieke-elementen-IfcCurtainWall.ids" .

wf:step-8 a wf:Step ;
    wf:id 8 ;
    wf:name "IDS Validation" ;
    wf:type "IDS" ;
    wf:idsFile "40-9.18g-Fysieke-elementen-IfcSlab.ids" .

wf:step-9 a wf:Step ;
    wf:id 9 ;
    wf:name "IDS Validation" ;
    wf:type "IDS" ;
    wf:idsFile "41-9.18h-Fysieke-elementen-IfcWall.ids" .

wf:step-10 a wf:Step ;
    wf:id 10 ;
    wf:name "IFC to RDF conversion" ;
    wf:type "IFC2RDF" .

wf:step-11 a wf:Step ;
    wf:id 11 ;
    wf:name "IFC Geometry to RDF conversion" ;
    wf:type "IFCGEOMETRY2RDF" .

wf:step-12 a wf:Step ;
    wf:id 12 ;
    wf:name "Create SPARQL dataset" ;
    wf:type "CREATE-SPARQL-DATASET" .