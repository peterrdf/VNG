@prefix wf:  <https://vng.nl/workflow/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

wf:workflow-12 a wf:Workflow ;
    wf:id 12 ;
    wf:name "Regel #12: U-waarde" ;
    wf:steps (
        wf:step-0 wf:step-1 wf:step-2 wf:step-3 wf:step-4
        wf:step-5 wf:step-6 wf:step-7 wf:step-8
    ) .

wf:step-0 a wf:Step ;
    wf:id 0 ;
    wf:name "IDS Validation" ;
    wf:type "IDS" ;
    wf:idsFile "01-9-ILS-voor-Ruimten-in-de-omgevingswet.ids" .

wf:step-1 a wf:Step ;
    wf:id 1 ;
    wf:name "IDS Validation" ;
    wf:type "IDS" ;
    wf:idsFile "07-9.02-Project.ids" .

wf:step-2 a wf:Step ;
    wf:id 2 ;
    wf:name "IDS Validation" ;
    wf:type "IDS" ;
    wf:idsFile "10-9.04-Kadastraal-Perceel.ids" .

wf:step-3 a wf:Step ;
    wf:id 3 ;
    wf:name "IDS Validation" ;
    wf:type "IDS" ;
    wf:idsFile "16-9.08-Gebruiksfunctie.ids" .

wf:step-4 a wf:Step ;
    wf:id 4 ;
    wf:name "IDS Validation" ;
    wf:type "IDS" ;
    wf:idsFile "37-9.18d-Fysieke-elementen-IfcCurtainWall.ids" .

wf:step-5 a wf:Step ;
    wf:id 5 ;
    wf:name "IDS Validation" ;
    wf:type "IDS" ;
    wf:idsFile "42-9.18i-Fysieke-elementen-Ifcwindow.ids" .

wf:step-6 a wf:Step ;
    wf:id 6 ;
    wf:name "IFC to RDF conversion" ;
    wf:type "IFC2RDF" .

wf:step-7 a wf:Step ;
    wf:id 7 ;
    wf:name "IFC Geometry to RDF conversion" ;
    wf:type "IFCGEOMETRY2RDF" .

wf:step-8 a wf:Step ;
    wf:id 8 ;
    wf:name "Create SPARQL dataset" ;
    wf:type "CREATE-SPARQL-DATASET" .