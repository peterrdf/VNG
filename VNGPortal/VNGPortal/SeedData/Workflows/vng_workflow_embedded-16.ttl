@prefix wf:  <https://vng.nl/workflow/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

wf:workflow-16 a wf:Workflow ;
    wf:id 16 ;
    wf:name "Regel #16: Vluchtbreedte" ;
    wf:steps (
        wf:step-0  wf:step-1  wf:step-2  wf:step-3  wf:step-4
        wf:step-5  wf:step-6  wf:step-7  wf:step-8  wf:step-9
        wf:step-10 wf:step-11 wf:step-12 wf:step-13 wf:step-14
    ) .

wf:step-0 a wf:Step ;
    wf:id 0 ;
    wf:name "IDS Validation" ;
    wf:type "IDS" ;
    wf:idsFile "01-9-ILS-voor-Ruimten-in-de-omgevingswet.ids" .

wf:step-1 a wf:Step ;
    wf:id 1 ;
    wf:name "IDS Validation" ;
    wf:type "IDS" ;
    wf:idsFile "07-9.02-Project.ids" .

