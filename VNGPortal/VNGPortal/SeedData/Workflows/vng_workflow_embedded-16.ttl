    wf:id 5 ;
    wf:name "IDS Validation" ;
    wf:type "IDS" ;
    wf:idsFile "20-9.10c-Verblijfsgebied-met-bezettingsgraad.ids" .

wf:step-6 a wf:Step ;
    wf:id 6 ;
    wf:name "IDS Validation" ;
    wf:type "IDS" ;
    wf:idsFile "22-9.10e-Bedgebied.ids" .

wf:step-7 a wf:Step ;
    wf:id 7 ;
    wf:name "IDS Validation" ;
    wf:type "IDS" ;
    wf:idsFile "27-9.12c-Bedruimte.ids" .

wf:step-8 a wf:Step ;
    wf:id 8 ;
    wf:name "IDS Validation" ;
    wf:type "IDS" ;
    wf:idsFile "32-9.16c-Vluchtroute.ids" .

wf:step-9 a wf:Step ;
    wf:id 9 ;
    wf:name "IDS Validation" ;
    wf:type "IDS" ;
    wf:idsFile "38-9.18e-Fysieke-elementen-IfcDoor.ids" .

wf:step-10 a wf:Step ;
