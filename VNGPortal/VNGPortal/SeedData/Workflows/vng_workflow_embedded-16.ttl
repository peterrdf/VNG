    wf:type "IDS" ;
    wf:idsFile "13-9.06a-Bouwlaag-voorheen-verdieping.ids" .

wf:step-3 a wf:Step ;
    wf:id 3 ;
    wf:name "IDS Validation" ;
    wf:type "IDS" ;
    wf:idsFile "16-9.08-Gebruiksfunctie.ids" .

wf:step-4 a wf:Step ;
    wf:id 4 ;
    wf:name "IDS Validation" ;
    wf:type "IDS" ;
    wf:idsFile "19-9.10b-Verblijfsgebied.ids" .

