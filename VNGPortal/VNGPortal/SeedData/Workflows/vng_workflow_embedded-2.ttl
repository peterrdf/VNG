@prefix wf:  <https://vng.nl/workflow/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

wf:workflow-2 a wf:Workflow ;
    wf:id 2 ;
    wf:name "Regel #2: Maximale bouwhoogte" ;
    wf:steps (
        wf:step-0  wf:step-1  wf:step-2  wf:step-3  wf:step-4
        wf:step-5  wf:step-6  wf:step-7  wf:step-8  wf:step-9
        wf:step-10 wf:step-11 wf:step-12 wf:step-13 wf:step-14
        wf:step-15 wf:step-16 wf:step-17 wf:step-18 wf:step-19
    ) .

wf:step-0 a wf:Step ;
    wf:id 0 ;
    wf:name "IDS Validation" ;
    wf:type "IDS" ;
    wf:idsFile "01-9-ILS-voor-Ruimten-in-de-omgevingswet.ids" .

wf:step-1 a wf:Step ;
    wf:id 1 ;
    wf:name "IDS Validation" ;
    wf:type "IDS" ;
    wf:idsFile "02-9.01a-Georeferentie.ids" .

wf:step-2 a wf:Step ;
    wf:id 2 ;
    wf:name "IDS Validation" ;
    wf:type "IDS" ;
    wf:idsFile "03-9.01b-Coordinatenstelsel.ids" .

wf:step-3 a wf:Step ;
    wf:id 3 ;
    wf:name "IDS Validation" ;
    wf:type "IDS" ;
    wf:idsFile "04-9.01c-Projectadres-IFC4X3-ADD2.ids" .

wf:step-4 a wf:Step ;
    wf:id 4 ;
    wf:name "IDS Validation" ;
    wf:type "IDS" ;
    wf:idsFile "05-9.01d-Perceeladres-IFC4.ids" .

wf:step-5 a wf:Step ;
    wf:id 5 ;
    wf:name "IDS Validation" ;
    wf:type "IDS" ;
    wf:idsFile "06-9.01e-Gebouwadres-IFC4.ids" .

wf:step-6 a wf:Step ;
    wf:id 6 ;
    wf:name "IDS Validation" ;
    wf:type "IDS" ;
    wf:idsFile "07-9.02-Project.ids" .

wf:step-7 a wf:Step ;
    wf:id 7 ;
    wf:name "IDS Validation" ;
    wf:type "IDS" ;
    wf:idsFile "09-9.03b-Bouwwerkperceel.ids" .

wf:step-8 a wf:Step ;
    wf:id 8 ;
    wf:name "IDS Validation" ;
    wf:type "IDS" ;
    wf:idsFile "10-9.04-Kadastraal-Perceel.ids" .

wf:step-9 a wf:Step ;
    wf:id 9 ;
    wf:name "IDS Validation" ;
    wf:type "IDS" ;
    wf:idsFile "13-9.06a-Bouwlaag-voorheen-verdieping.ids" .

wf:step-10 a wf:Step ;
    wf:id 10 ;
    wf:name "IFC to RDF conversion" ;
    wf:type "IFC2RDF" .

wf:step-11 a wf:Step ;
    wf:id 11 ;
    wf:name "IFC Geometry to RDF conversion" ;
    wf:type "IFCGEOMETRY2RDF" .

wf:step-12 a wf:Step ;
    wf:id 12 ;
    wf:name "Create SPARQL dataset" ;
    wf:type "CREATE-SPARQL-DATASET" .

wf:step-13 a wf:Step ;
    wf:id 13 ;
    wf:name "Insert IFC4ADD2" ;
    wf:description "Inserts the IFC4ADD2 ontology into the SPARQL dataset." ;
    wf:type "SPARQL" ;
    wf:queryRef "InsertIFC4ADD2Ontology" .

wf:step-14 a wf:Step ;
    wf:id 14 ;
    wf:name "Insert Areas" ;
    wf:description "Retrieves residential ('wonen') planning zones based on the location of the building in the IFC model." ;
    wf:type "SPARQL" ;
    wf:queryRef "InsertAreas" .

wf:step-15 a wf:Step ;
    wf:id 15 ;
    wf:name "Insert BBoxes" ;
    wf:description "Calculates the 3D bounding box for every geometry." ;
    wf:type "SPARQL" ;
    wf:queryRef "InsertBBoxes" .

wf:step-16 a wf:Step ;
    wf:id 16 ;
    wf:name "Insert Projections" ;
    wf:description "Generates a 2D map projection for every 3D geometry." ;
    wf:type "SPARQL" ;
    wf:queryRef "InsertProjections" .

wf:step-17 a wf:Step ;
    wf:id 17 ;
    wf:name "Insert Topological Relations" ;
    wf:description "Calculates whether every geometry in the building model spatially overlaps with residential (\"wonen\") planning zones." ;
    wf:type "SPARQL" ;
    wf:queryRef "InsertTopologicalRelations-IfcWall-IfcRoof" .

wf:step-18 a wf:Step ;
    wf:id 18 ;
    wf:name "Validate Topological Relations" ;
    wf:description "Validates that every geometry in the building is fully contained within residential (\"wonen\") planning zones." ;
    wf:type "SHACL" ;
    wf:shaclValidationRef "ValidateTopologicalRelations.ttl" .

wf:step-19 a wf:Step ;
    wf:id 19 ;
    wf:name "Validate Height" ;
    wf:description "Validates that every geometry in the model has a height within the allowed range." ;
    wf:type "SHACL" ;
    wf:shaclValidationRef "ValidateHeight.ttl" .