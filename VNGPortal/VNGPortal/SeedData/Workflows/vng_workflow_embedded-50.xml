			    ]]>
			</description>
			<type><![CDATA[3DVIEW]]></type>
			<parameters>
				<queries>
					<sparql>
						<id><![CDATA[Union]]></id>
						<query>
							<![CDATA[
PREFIX vng: <http://vng.nl/geometry-ext.ttl#>

SELECT ?base64Data
WHERE {
    BIND(vng:gmCylinder(1.0, 1.0) AS ?a)
	BIND(3.14159265358979 AS ?pi)
    BIND(vng:gmRotation(vng:gmCylinder(1.0, 1.0), 90 * ?pi / 180.0, 0.0, 0.0) AS ?b)
	BIND(1 AS ?difference)
    BIND(vng:gmBooleanOperation(?a, ?b, ?difference) AS ?base64Data)
}
							]]>
						</query>
						<geometryVariable><![CDATA[base64Data]]></geometryVariable>
					</sparql>
				</queries>
