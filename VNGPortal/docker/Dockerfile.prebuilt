# Stage 1: Build IDSValidator
FROM ubuntu:24.04 AS ids-builder

RUN apt-get update && \
    apt-get install -y g++ && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /src/IDSValidator
COPY IDSValidator/ .

RUN chmod +x build.sh && ./build.sh

# Stage 2: Runtime image
FROM mcr.microsoft.com/dotnet/aspnet:9.0-noble

WORKDIR /app

# Install JDK 25 (Eclipse Temurin) via Adoptium APT repository
RUN apt-get update && \
    apt-get install -y wget apt-transport-https gnupg && \
    wget -O - https://packages.adoptium.net/artifactory/api/gpg/key/public | gpg --dearmor -o /usr/share/keyrings/adoptium.gpg && \
    echo "deb [signed-by=/usr/share/keyrings/adoptium.gpg] https://packages.adoptium.net/artifactory/deb $(awk -F= '/^VERSION_CODENAME/{print $2}' /etc/os-release) main" > /etc/apt/sources.list.d/adoptium.list && \
    apt-get update && \
    apt-get install -y temurin-25-jdk && \
    apt-get purge -y wget gnupg && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

COPY VNGPortal/bin/Release/net9.0/publish/ .

# Copy IDSValidator binary from builder stage
COPY --from=ids-builder /src/IDSValidator/IDSValidator ./IDSValidator

# Make the .so files and IDSValidator executable
RUN chmod +x libifcengine.so IDSValidator

# Register /app in the linker cache
RUN echo "/app" > /etc/ld.so.conf.d/vng.conf && ldconfig

ENV ASPNETCORE_URLS=http://+:8080

# Force libifcengine.so to be loaded before other libs
ENV LD_PRELOAD=/app/libifcengine.so

ENTRYPOINT ["dotnet", "VNGPortal.dll"]