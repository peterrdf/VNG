# Stage 1: Build IDSValidator
FROM ubuntu:24.04 AS ids-builder

RUN apt-get update && \
    apt-get install -y g++ && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /src/IDSValidator
COPY IDSValidator/ .

RUN chmod +x build.sh && ./build.sh

# Stage 2: Runtime image
FROM mcr.microsoft.com/dotnet/aspnet:9.0-noble

WORKDIR /app

# Install OpenJDK
RUN apt-get update && \
    apt-get install -y openjdk-21-jre-headless && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

COPY VNGPortal/bin/Release/net9.0/publish/ .

# Copy IDSValidator binary from builder stage
COPY --from=ids-builder /src/IDSValidator/IDSValidator ./IDSValidator

# Make the .so files and IDSValidator executable
RUN chmod +x libifcengine.so IDSValidator

# Register /app in the linker cache
RUN echo "/app" > /etc/ld.so.conf.d/vng.conf && ldconfig

ENV ASPNETCORE_URLS=http://+:8080

# Force libifcengine.so to be loaded before other libs
ENV LD_PRELOAD=/app/libifcengine.so

ENTRYPOINT ["dotnet", "VNGPortal.dll"]